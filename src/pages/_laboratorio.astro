---
/**
 * Laboratório: vitrine de todos os tokens.
 * Lê src/styles/tokens.css na compilação, então nunca fica desatualizado.
 * noindex. O sublinhado no nome tira a página das rotas automáticas: ela é incluída
 * pela integração `laboratorio` do astro.config.mjs, em todo ambiente menos a produção.
 */
import { createHash } from "node:crypto";
import Abertura from "../components/blocos/Abertura.astro";
import CabecalhoCase from "../components/blocos/CabecalhoCase.astro";
import ListaDeEntradas from "../components/blocos/ListaDeEntradas.astro";
import ProjetosBento from "../components/blocos/ProjetosBento.astro";
import Disponibilidade from "../components/ui/Disponibilidade.astro";
import Selo from "../components/ui/Selo.astro";
import Seta from "../components/ui/Seta.astro";
import LayoutBase from "../components/layout/LayoutBase.astro";
import {
	artigosPiorCaso,
	cabecalhoPiorCaso,
	entradasPiorCaso,
	perfilPiorCaso,
} from "../dados/pior-caso";
import tokensCss from "../styles/tokens.css?raw";

type Token = { nome: string; valor: string };

// O arquivo é dividido pelos três cabeçalhos de camada.
const [, primitivosCss = "", semanticosCss = "", componentesCss = ""] =
	tokensCss.split(/\/\* -{10} \d\. /);

const lerTokens = (css: string): Token[] =>
	[...css.matchAll(/^\s*(--[\w-]+):\s*(.+?);/gm)].map(([, nome = "", valor = ""]) => ({
		nome,
		valor,
	}));

const primitivos = lerTokens(primitivosCss);
const semanticos = lerTokens(semanticosCss);
const componentes = lerTokens(componentesCss);

const valorDe = (nome: string) => primitivos.find((t) => t.nome === nome)?.valor ?? "";
const referencia = (valor: string) => valor.match(/var\((--[\w-]+)\)/)?.[1] ?? "";

// Contraste WCAG 2.2
const luminancia = (hex: string) => {
	const [r = 0, g = 0, b = 0] = [1, 3, 5]
		.map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
		.map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
	return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contraste = (a: string, b: string) => {
	const [claro, escuro] = [luminancia(a), luminancia(b)].sort((x, y) => y - x);
	return ((claro ?? 0) + 0.05) / ((escuro ?? 0) + 0.05);
};
const nivel = (razao: number) =>
	razao >= 7
		? "AAA"
		: razao >= 4.5
			? "AA"
			: razao >= 3
				? "AA só para texto grande"
				: "Só decorativo";

const hexDoSemantico = (nome: string) =>
	valorDe(referencia(semanticos.find((t) => t.nome === nome)?.valor ?? ""));
const fundo = hexDoSemantico("--color-fundo");
const destaqueCase = hexDoSemantico("--color-destaque-case");
const inverso = hexDoSemantico("--color-inverso-fundo");

const cores = semanticos
	.filter((t) => t.nome.startsWith("--color-"))
	.map((t) => {
		const primitivo = referencia(t.valor);
		const hex = valorDe(primitivo);
		// "Sobre destaque" é medido contra o azul; o texto inverso, contra o fundo escuro;
		// o resto, contra o fundo da página.
		const base =
			t.nome === "--color-sobre-destaque-case"
				? destaqueCase
				: t.nome === "--color-inverso-texto"
					? inverso
					: fundo;
		const ehFundo = t.nome === "--color-fundo";
		const ehTranslucida = !hex.startsWith("#");
		const razao = contraste(hex, base);
		return {
			...t,
			primitivo,
			hex,
			ehFundo,
			ehTranslucida,
			medidoContra:
				base === destaqueCase
					? "o azul de destaque"
					: base === inverso
						? "o fundo inverso"
						: "o fundo",
			razao: razao.toFixed(2).replace(".", ","),
			nivel: nivel(razao),
		};
	});

const textos = semanticos.filter((t) => t.nome.startsWith("--text-"));
const espacos = primitivos.filter((t) => t.nome.startsWith("--prim-space-"));
const raios = semanticos.filter((t) => t.nome.startsWith("--radius-"));
const duracoes = semanticos.filter((t) => t.nome.startsWith("--motion-duration-"));
const curva = semanticos.find((t) => t.nome === "--motion-ease-out");
const valorPrimitivo = (t: Token) => valorDe(referencia(t.valor)) || t.valor;

// Cada amostra aplica o próprio token. Um atributo style seria bloqueado pela CSP,
// então as regras viram um único bloco <style>, liberado pelo hash dele.
const regra = (classe: string, propriedade: string, lista: Token[]) =>
	lista.map((t) => `.${classe}[data-token="${t.nome}"]{${propriedade}:var(${t.nome})}`).join("");
const cssDasAmostras = [
	regra("lab__amostra", "background", cores),
	regra("lab__especime", "font-size", textos),
	// Espaço entre letras de cada nível: os títulos têm token próprio; do rótulo para baixo, o do texto.
	textos
		.map((t) => {
			const nivel = t.nome.replace("--text-", "");
			const proprio = semanticos.some((x) => x.nome === `--tracking-${nivel}`);
			return `.lab__especime[data-token="${t.nome}"]{letter-spacing:var(--tracking-${proprio ? nivel : "texto"})}`;
		})
		.join(""),
	regra("lab__barra", "inline-size", espacos),
	regra("lab__caixa", "border-radius", raios),
	regra("lab__ponto", "transition-duration", duracoes),
].join("");
Astro.csp?.insertStyleHash(
	`sha256-${createHash("sha256").update(cssDasAmostras).digest("base64")}`,
);
---

<LayoutBase
	titulo="Laboratório · taiane.cc"
	descricao="Tokens e componentes do design system do taiane.cc."
	noindex
>
	<style is:inline set:html={cssDasAmostras} />
	<div class="envoltorio lab">
		<header class="lab__topo">
			<h1>Laboratório</h1>
			<p>
				Todos os tokens do site, lidos direto de <code>src/styles/tokens.css</code>. Interface base
				da etapa 0.3.0, conforme docs/especificacao-base-debora.md.
			</p>
		</header>

		<section aria-labelledby="titulo-cor">
			<h2 id="titulo-cor">Cor</h2>
			<p>
				Contraste medido pela fórmula da WCAG 2.2. Texto comum precisa de 4,5:1 para o nível AA.
			</p>
			<ul class="lab__cores" role="list">
				{cores.map((c) => (
					<li class="lab__cor">
						<span class="lab__amostra" data-token={c.nome} />
						<code>{c.nome}</code>
						<span class="lab__meta">
							{c.hex} · {c.primitivo}
						</span>
						<span class="lab__meta">
							{c.ehFundo
								? "Base das medições"
								: c.ehTranslucida
									? "Translúcida: realce de fundo, sem texto"
									: `${c.razao}:1 contra ${c.medidoContra} · ${c.nivel}`}
						</span>
					</li>
				))}
			</ul>
		</section>

		<section aria-labelledby="titulo-tipo">
			<h2 id="titulo-tipo">Tipografia</h2>
			<p>
				Google Sans Flex, pesos 400, 500 e 700, com espaço entre letras mais fechado nos tamanhos
				maiores. Os tamanhos de título de entrada, título do case, espaço entre seções e margem da
				página mudam em 768 e 1200 pixels: aqui aparece o valor do celular.
			</p>
			<ul class="lab__lista" role="list">
				{textos.map((t) => (
					<li class="lab__tipo">
						<span class="lab__especime" data-token={t.nome}>
							Design de produto com pensamento sistêmico
						</span>
						<code>{t.nome}</code>
						<span class="lab__meta">{valorPrimitivo(t)}</span>
					</li>
				))}
			</ul>
			<p class="lab__peso" data-peso="400">
				Peso 400: Design de produto com pensamento sistêmico
			</p>
			<p class="lab__peso" data-peso="500">
				Peso 500: Design de produto com pensamento sistêmico
			</p>
			<p class="lab__peso" data-peso="700">
				Peso 700: Design de produto com pensamento sistêmico
			</p>
			<p class="lab__mono">
				<code>--font-tecnica</code>, fonte mono do sistema, só nos marcadores de rascunho: [TEXTO DA
				TAIANE]
			</p>
		</section>

		<section aria-labelledby="titulo-espaco">
			<h2 id="titulo-espaco">Espaçamento</h2>
			<p>Escala da especificação: 0, 2, 4, 8, 16, 24, 32, 40, 48, 56 e 80 pixels.</p>
			<ul class="lab__lista" role="list">
				{espacos.map((t) => (
					<li class="lab__espaco">
						<span class="lab__barra" data-token={t.nome} />
						<code>{t.nome}</code>
						<span class="lab__meta">{t.valor}</span>
					</li>
				))}
			</ul>
		</section>

		<section aria-labelledby="titulo-raio">
			<h2 id="titulo-raio">Raios</h2>
			<ul class="lab__raios" role="list">
				{raios.map((t) => (
					<li class="lab__raio">
						<span class="lab__caixa" data-token={t.nome} />
						<code>{t.nome}</code>
						<span class="lab__meta">{valorPrimitivo(t)}</span>
					</li>
				))}
			</ul>
		</section>

		<section aria-labelledby="titulo-movimento" class="lab__movimento">
			<h2 id="titulo-movimento">Movimento</h2>
			<p>
				Curva <code>--motion-ease-out</code>: {curva ? valorPrimitivo(curva) : ""}. Só
				<code>transform</code> e <code>opacity</code>. Com redução de movimento ativada no sistema,
				as amostras saltam direto para o fim.
			</p>
			<label class="lab__controle">
				<input type="checkbox" />
				Mover as amostras
			</label>
			<ul class="lab__lista" role="list">
				{duracoes.map((t) => (
					<li class="lab__duracao">
						<span class="lab__trilho" aria-hidden="true">
							<span class="lab__ponto" data-token={t.nome} />
						</span>
						<code>{t.nome}</code>
						<span class="lab__meta">{valorPrimitivo(t)}</span>
					</li>
				))}
			</ul>
		</section>

		<section aria-labelledby="titulo-componentes">
			<h2 id="titulo-componentes">Tokens de componente</h2>
			<p>
				Para ver o link de pular, recarregue a página e aperte Tab. Para ver o foco, navegue com Tab
				até <a href="#conteudo">este link</a>.
			</p>
			<ul class="lab__lista" role="list">
				{componentes.map((t) => (
					<li class="lab__linha">
						<code>{t.nome}</code>
						<span class="lab__meta">{t.valor}</span>
					</li>
				))}
			</ul>
		</section>

		<section aria-labelledby="titulo-avulsos">
			<h2 id="titulo-avulsos">Componentes avulsos</h2>
			<p>
				Setas: diagonal só para links externos, reta para páginas do site, para baixo para rolar na
				mesma página. O selo saiu do site na direção de arte v3 e fica aqui até a rodada 2.
			</p>
			<div class="lab__avulsos">
				<Seta direcao="diagonal" />
				<Seta direcao="direita" />
				<Seta direcao="baixo" />
				<Disponibilidade />
				<Selo id="lab-selo" />
			</div>
		</section>

		<section aria-labelledby="titulo-pior-caso" id="pior-caso">
			<h2 id="titulo-pior-caso">Pior caso</h2>
			<p>
				Os mesmos componentes da página real, com dados extremos e realistas: nomes e títulos
				longos, uma palavra sem espaços, e-mail enorme, textos no limite do schema e lista vazia.
				Dados em <code>src/dados/pior-caso.ts</code>.
			</p>
		</section>
	</div>

	<div class="lab__pior-caso">
		<Abertura perfil={perfilPiorCaso} idBase="pior-abertura" nivel={2} />
		<ProjetosBento id="pior-projetos" rotulo="Projetos no limite" entradas={entradasPiorCaso} />
		<ListaDeEntradas
			id="pior-entradas"
			rotulo="Entradas no limite"
			entradas={entradasPiorCaso}
			vazio="Lista vazia."
		/>
		<ListaDeEntradas
			id="pior-artigos"
			rotulo="Artigos no limite"
			entradas={artigosPiorCaso}
			vazio="Lista vazia."
			titulosEmDuasLinhas
		/>
		<ListaDeEntradas
			id="pior-vazia"
			rotulo="Lista vazia"
			entradas={[]}
			vazio="Os projetos entram aqui em breve."
		/>
		<div class="envoltorio">
			<div class="lab__case">
				<CabecalhoCase {...cabecalhoPiorCaso} nivel={2} />
			</div>
		</div>
	</div>
</LayoutBase>

<style>
	.lab__avulsos {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-grande);
	}

	.lab {
		display: grid;
		gap: var(--space-secao);
		padding-block: var(--space-bloco) var(--space-secao);
	}

	.lab section {
		display: grid;
		gap: var(--space-medio);
		align-content: start;
	}

	.lab__topo {
		display: grid;
		gap: var(--space-medio);
	}

	.lab__topo p,
	.lab section > p {
		color: var(--color-texto-secundario);
	}

	.lab code {
		font-size: var(--text-pequeno);
	}

	.lab__meta {
		font-family: var(--font-tecnica);
		font-size: var(--text-pequeno);
		color: var(--color-texto-secundario);
	}

	.lab__lista,
	.lab__cores,
	.lab__raios {
		padding: 0;
		list-style: none;
		display: grid;
		gap: var(--space-grande);
	}

	/* Cor */
	.lab__cores {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
		gap: var(--space-grande) var(--space-medio);
	}

	.lab__cor {
		display: grid;
		gap: var(--space-minimo);
	}

	.lab__amostra {
		block-size: var(--space-secao);
		margin-block-end: var(--space-pequeno);
		border-radius: var(--radius-medio);
		box-shadow: inset 0 0 0 1px var(--color-borda);
	}

	/* Tipografia, espaçamento e componentes */
	.lab__tipo,
	.lab__espaco,
	.lab__linha,
	.lab__duracao {
		display: grid;
		gap: var(--space-minimo) var(--space-medio);
		padding-block-end: var(--space-medio);
		border-block-end: 1px solid var(--color-borda);
	}

	.lab__especime {
		line-height: var(--leading-titulo);
		font-weight: var(--peso-titulo);
	}

	.lab__mono {
		font-family: var(--font-tecnica);
	}

	.lab__peso {
		font-size: var(--text-subtitulo);
		letter-spacing: var(--tracking-subtitulo);
		line-height: var(--leading-subtitulo);
		color: var(--color-texto);
	}

	.lab__peso[data-peso="400"] {
		font-weight: var(--peso-corpo);
	}

	.lab__peso[data-peso="500"] {
		font-weight: var(--peso-titulo);
	}

	.lab__peso[data-peso="700"] {
		font-weight: var(--peso-forte);
	}

	.lab__pior-caso {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-secao);
	}

	.lab__case {
		padding-block: var(--space-secao);
	}

	@media (min-width: 1200px) {
		.lab__case {
			max-inline-size: 50%;
		}
	}

	.lab__barra {
		block-size: var(--space-medio);
		background: var(--color-marca);
	}

	@media (min-width: 48rem) {
		.lab__espaco,
		.lab__linha,
		.lab__duracao {
			grid-template-columns: minmax(0, 1fr) 16rem 10rem;
			align-items: center;
		}

		.lab__tipo {
			grid-template-columns: minmax(0, 1fr) 12rem;
			align-items: baseline;
		}

		.lab__tipo .lab__meta {
			grid-column: 2;
		}

		.lab__linha {
			grid-template-columns: 20rem minmax(0, 1fr);
		}
	}

	/* Raios */
	.lab__raios {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
		gap: var(--space-medio);
	}

	.lab__raio {
		display: grid;
		gap: var(--space-minimo);
	}

	.lab__caixa {
		block-size: var(--space-secao);
		margin-block-end: var(--space-pequeno);
		background: var(--color-texto);
	}

	/* Movimento */
	.lab__controle {
		display: inline-flex;
		gap: var(--space-pequeno);
		align-items: center;
		justify-self: start;
		cursor: pointer;
	}

	.lab__controle input {
		inline-size: var(--space-medio);
		block-size: var(--space-medio);
		accent-color: var(--color-marca);
	}

	.lab__trilho {
		container-type: inline-size;
		display: block;
		block-size: var(--space-medio);
		border-block-end: 1px solid var(--color-borda);
	}

	.lab__ponto {
		display: block;
		inline-size: var(--space-medio);
		block-size: var(--space-medio);
		border-radius: var(--radius-pilula);
		background: var(--color-marca);
		transition-property: transform;
		transition-timing-function: var(--motion-ease-out);
	}

	.lab__movimento:has(.lab__controle input:checked) .lab__ponto {
		transform: translateX(calc(100cqi - var(--space-medio)));
	}
</style>
