---
/**
 * Protótipo da abertura (etapa 0.3.0, skill prototype): três versões atrás do seletor.
 * Rota /laboratorio/abertura, incluída pela integração `laboratorio`, fora da produção.
 * Sai do projeto quando a Taiane escolher a versão.
 */
import { getCollection } from "astro:content";
import Projetos from "../components/blocos/Projetos.astro";
import LayoutBase from "../components/layout/LayoutBase.astro";
import Mosaico from "../prototipos/abertura/Mosaico.astro";
import Retrato from "../prototipos/abertura/Retrato.astro";
import SlideLimpo from "../prototipos/abertura/SlideLimpo.astro";
import Seletor from "../prototipos/Seletor.astro";

const projetos = (await getCollection("cases"))
	.sort((a, b) => a.data.ordem - b.data.ordem)
	.map(({ id, data }) => ({
		titulo: data.titulo,
		empresa: data.empresa,
		ano: data.ano,
		chamada: data.chamada,
		href: `/cases/${id}`,
	}));
---

<LayoutBase
	titulo="Protótipo da abertura · Laboratório"
	descricao="Três versões da abertura do taiane.cc para comparar."
	noindex
	cabecalho={false}
>
	<template data-variante>
		<SlideLimpo />
	</template>
	<template data-variante>
		<Mosaico />
	</template>
	<template data-variante>
		<Retrato />
	</template>

	<div id="palco"></div>
	<Projetos projetos={projetos} />

	<Seletor nomes={["Slide limpo", "Mosaico", "Retrato"]} />
</LayoutBase>
