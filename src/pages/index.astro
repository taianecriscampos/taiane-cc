---
/**
 * Página inicial. Ordem de leitura: abertura, projetos, artigos, sobre, skills e ferramentas.
 * O rodapé, com "Me chama!", vem do LayoutBase.
 */
import Abertura from "../components/blocos/Abertura.astro";
import Ferramentas from "../components/blocos/Ferramentas.astro";
import ListaDeEntradas from "../components/blocos/ListaDeEntradas.astro";
import Projetos from "../components/blocos/Projetos.astro";
import Skills from "../components/blocos/Skills.astro";
import Sobre from "../components/blocos/Sobre.astro";
import LayoutBase from "../components/layout/LayoutBase.astro";
import { perfil } from "../dados/perfil";
import { artigos } from "../dados/artigos";
import { projetosDosCases } from "../dados/projetos";

const projetos = await projetosDosCases();
---

<LayoutBase
	titulo={`${perfil.nome} · ${perfil.cargo}`}
	descricao={`${perfil.nome}, ${perfil.cargo}. ${perfil.frase}`}
>
	<Abertura />
	<Projetos projetos={projetos} />
	<ListaDeEntradas
		id="artigos"
		rotulo="Artigos"
		entradas={artigos}
		titulosEmDuasLinhas
		vazio="Os artigos entram aqui em breve."
	/>
	<Sobre />
	<Skills />
	<Ferramentas />
</LayoutBase>
