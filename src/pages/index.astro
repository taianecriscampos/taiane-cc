---
/**
 * Página inicial. Ordem de leitura: abertura, projetos, textos, sobre e "Vamos conversar?".
 * O rodapé vem do LayoutBase.
 */
import { getCollection } from "astro:content";
import Abertura from "../components/blocos/Abertura.astro";
import Contato from "../components/blocos/Contato.astro";
import ListaDeEntradas from "../components/blocos/ListaDeEntradas.astro";
import Sobre from "../components/blocos/Sobre.astro";
import LayoutBase from "../components/layout/LayoutBase.astro";
import type { Entrada } from "../components/ui/Entrada.astro";
import { perfil } from "../dados/perfil";
import { textos } from "../dados/textos";

// "Novo" vai para o case mais recente; no empate, o primeiro da ordem.
const cases = (await getCollection("cases")).sort((a, b) => a.data.ordem - b.data.ordem);
const anoMaisRecente = Math.max(...cases.map((c) => c.data.ano));
const idDoNovo = cases.find((c) => c.data.ano === anoMaisRecente)?.id;

const projetos: Entrada[] = cases.map(({ id, data }) => ({
	titulo: data.titulo,
	ano: data.ano,
	onde: data.cliente,
	descricao: data.chamada.startsWith("[") ? undefined : data.chamada,
	href: `/cases/${id}`,
	novo: id === idDoNovo,
}));
---

<LayoutBase
	titulo={`${perfil.nome} · ${perfil.cargo}`}
	descricao={`${perfil.nome}, ${perfil.cargo}. ${perfil.frase}`}
>
	<Abertura />
	<ListaDeEntradas
		id="projetos"
		rotulo="Projetos"
		entradas={projetos}
		vazio="Os projetos entram aqui em breve."
	/>
	<ListaDeEntradas
		id="textos"
		rotulo="Textos"
		entradas={textos}
		vazio="Os textos entram aqui em breve."
	/>
	<Sobre />
	<Contato />
</LayoutBase>
