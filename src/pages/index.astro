---
/**
 * Página inicial. Ordem de leitura: abertura, projetos, sobre, experiência e formação,
 * ferramentas, contato. O rodapé vem do LayoutBase.
 */
import { getCollection } from "astro:content";
import Abertura from "../components/blocos/Abertura.astro";
import Contato from "../components/blocos/Contato.astro";
import Experiencia from "../components/blocos/Experiencia.astro";
import Ferramentas from "../components/blocos/Ferramentas.astro";
import Projetos from "../components/blocos/Projetos.astro";
import Sobre from "../components/blocos/Sobre.astro";
import LayoutBase from "../components/layout/LayoutBase.astro";
import { perfil } from "../dados/perfil";

const projetos = (await getCollection("cases"))
	.sort((a, b) => a.data.ordem - b.data.ordem)
	.map(({ id, data }) => ({
		titulo: data.titulo,
		empresa: data.empresa,
		ano: data.ano,
		chamada: data.chamada,
		href: `/cases/${id}`,
	}));
---

<LayoutBase
	titulo={`${perfil.nome} · ${perfil.cargo}`}
	descricao={`${perfil.nome}, ${perfil.cargo}. ${perfil.frase}`}
>
	<Abertura />
	<Projetos projetos={projetos} />
	<Sobre />
	<Experiencia />
	<Ferramentas />
	<Contato />
</LayoutBase>
