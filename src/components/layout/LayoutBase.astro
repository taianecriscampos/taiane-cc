---
/**
 * Layout base de todas as páginas.
 * Idioma pt-BR, título, descrição, opção de noindex, link "Pular para o conteúdo", cabeçalho e rodapé.
 */
import "../../styles/global.css";
import Cabecalho, { type LinkDoCabecalho } from "./Cabecalho.astro";
import Rodape from "./Rodape.astro";

/**
 * Até o lançamento (1.0.0), nenhuma página entra nos buscadores.
 * Na 1.0.0, troque para true: só as páginas com `noindex` explícito continuam de fora.
 */
const indexacaoLiberada = false;

interface Props {
	titulo: string;
	descricao: string;
	/** true para páginas que nunca devem aparecer em buscadores (ex.: /laboratorio). */
	noindex?: boolean;
	/** Nos cases, o cabeçalho mostra as seções do case no lugar das seções da página inicial. */
	secoesDoCase?: LinkDoCabecalho[];
}

const { titulo, descricao, secoesDoCase } = Astro.props;
const noindex = Astro.props.noindex ?? !indexacaoLiberada;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titulo}</title>
		<meta name="description" content={descricao} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link
			rel="preload"
			href="/fontes/schibsted-grotesk-variavel-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="pular-conteudo" href="#conteudo">
			Pular para o conteúdo
		</a>
		{secoesDoCase ? (
			<Cabecalho links={secoesDoCase} rotulo="Neste case" quebra="computador" />
		) : (
			<Cabecalho />
		)}
		<main id="conteudo" tabindex="-1">
			<slot />
		</main>
		<Rodape />
	</body>
</html>
