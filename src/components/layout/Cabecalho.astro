---
/**
 * Cabeçalho de todas as páginas: fixo no topo, translúcido, sem linha embaixo.
 * Esquerda: o nome leva ao início ("Tai" no celular). Centro: a ilha. Direita: o modelo de
 * trabalho com o ponto verde ("Remoto ou híbrido"; no celular, só o ponto). O leitor
 * de tela lê a frase completa: "Disponível para trabalho remoto ou híbrido".
 *
 * A ilha (docs/movimento-ilha.md) tem três níveis:
 * 0. Cápsula: número e nome da seção atual, numa faixa vertical atrás de uma janela. A faixa
 *    desliza até a seção atual; uma rolagem rápida por várias seções vira um movimento só.
 * 1. Lista de seções, que entram uma depois da outra; um ponto só desliza até a seção atual.
 * 2. Detalhe da seção escolhida: número, nome, uma frase e "Ir para a seção".
 * Esc volta um nível por vez; "Fechar" volta direto à cápsula e devolve o foco ao botão.
 *
 * Por dentro: uma camada de vidro (o fundo) desenha a ilha nos três níveis. Ela é um pouco maior
 * que o maior nível e fica recortada (clip-path) no tamanho do nível atual. Só o recorte anima;
 * o texto nunca estica.
 * Mola por movimento: todo crescimento passa do tamanho final sempre pelos mesmos 6 px (3 de cada
 * lado na largura, 6 embaixo na altura), cresça a ilha pouco ou muito, e assenta. Encolher não
 * tem mola. Um movimento novo parte de onde a ilha está, sem pulo.
 *
 * Teclado: tudo sem animação; o foco vai para a seção atual (lista) ou para "Ir para a seção"
 * (detalhe, que o leitor de tela anuncia com a frase). Setas, Home e End andam pela lista.
 * Nos cases, a lista traz as seções do case e as frases saem do próprio texto.
 */
import { perfil } from "../../dados/perfil";
import Disponibilidade from "../ui/Disponibilidade.astro";
import Seta from "../ui/Seta.astro";

export interface LinkDoCabecalho {
	texto: string;
	href: string;
	/** Frase curta do detalhe da ilha (nível 3). */
	frase?: string;
}

interface Props {
	links?: LinkDoCabecalho[];
	/** Nome da navegação para o leitor de tela. */
	rotulo?: string;
	/** O primeiro item da lista: o topo da página. */
	inicio?: LinkDoCabecalho;
}

const {
	links = [
		{
			texto: "Projetos",
			href: "/#projetos",
			frase: "Cases de produto, do diagnóstico ao código.",
		},
		{
			texto: "Artigos",
			href: "/#artigos",
			frase: "O que escrevo sobre design, IA e engenharia.",
		},
		{ texto: "Sobre", href: "/#sobre", frase: "Trajetória, experiência e formação." },
		{ texto: "Skills", href: "/#skills", frase: "Competências e as ferramentas do dia a dia." },
	],
	rotulo = "Principal",
	inicio = { texto: "Início", href: "/#inicio", frase: "Quem eu sou, em uma frase e uma foto." },
} = Astro.props;

const numero = (i: number) => String(i + 1).padStart(2, "0");
// No celular aparece só o apelido; o resto do nome continua lá para o leitor de tela,
// e o texto visível faz parte do nome lido (critério 2.5.3).
const [curto, resto] = perfil.nome.startsWith(perfil.apelido)
	? [perfil.apelido, perfil.nome.slice(perfil.apelido.length)]
	: [perfil.nome, ""];
const itens = [inicio, ...links].map((link, i) => ({ ...link, numero: numero(i) }));
---

<header class="cabecalho">
	<div class="cabecalho__barra envoltorio">
		<!-- Sem espaço entre o apelido e o resto: "Tai" + "ane Cris Campos". -->
		<!-- prettier-ignore -->
		<a class="link cabecalho__nome" href="/">{curto}<span class="cabecalho__nome-resto">{resto}</span><span class="cabecalho__nome-oculto">, início</span></a>

		<nav class="ilha" aria-label={rotulo} data-ilha data-nivel="0">
			<div class="ilha__fundo" aria-hidden="true" data-fundo></div>

			<button class="ilha__botao" type="button" aria-expanded="false" aria-controls="ilha-painel">
				<span class="ilha__conteudo">
					<span class="ilha__janela ilha__numero" aria-hidden="true" data-mover>
						<span class="ilha__faixa" data-faixa>
							{itens.map((item) => (
								<span class="ilha__faixa-item">{item.numero}</span>
							))}
						</span>
					</span>
					<span class="ilha__janela" aria-hidden="true" data-mover data-janela-nome>
						<span class="ilha__faixa" data-faixa>
							{itens.map((item) => (
								<span class="ilha__faixa-item">{item.texto}</span>
							))}
						</span>
					</span>
					<span class="so-leitor-de-tela">
						Menu, seção atual: <span data-atual>{itens[0].texto}</span>
					</span>
					<span class="ilha__ponto" aria-hidden="true" data-mover></span>
				</span>
			</button>

			<div class="ilha__painel" id="ilha-painel">
				<div class="ilha__vista ilha__vista--lista" data-lista>
					<div class="ilha__topo">
						<p class="ilha__titulo" aria-hidden="true">
							Seções
						</p>
						<button class="ilha__acao" type="button" data-fechar>
							Fechar
						</button>
					</div>
					<div class="ilha__lista">
						<ul class="ilha__links" role="list">
							{itens.map((item) => (
								<li class="ilha__item">
									<a
										class="ilha__link"
										href={item.href}
										data-numero={item.numero}
										data-texto={item.texto}
										data-frase={item.frase ?? ""}
									>
										<span class="ilha__numero" aria-hidden="true">
											{item.numero}
										</span>
										{item.texto}
									</a>
								</li>
							))}
						</ul>
						<span class="ilha__ponto ilha__marcador" aria-hidden="true" data-marcador></span>
					</div>
				</div>

				<div
					class="ilha__vista ilha__vista--detalhe"
					role="group"
					aria-labelledby="ilha-detalhe-nome"
					data-detalhe
				>
					<div class="ilha__topo">
						<button class="ilha__acao" type="button" data-voltar>
							Voltar
						</button>
						<button class="ilha__acao" type="button" data-fechar>
							Fechar
						</button>
					</div>
					<p class="ilha__detalhe-titulo">
						<span class="ilha__numero" aria-hidden="true" data-detalhe-numero></span>
						<span id="ilha-detalhe-nome" data-detalhe-nome></span>
					</p>
					<p class="ilha__detalhe-frase" id="ilha-detalhe-frase" data-detalhe-frase></p>
					<a class="ilha__ir" href="#" aria-describedby="ilha-detalhe-frase" data-detalhe-link>
						<span>Ir para a seção</span>
						<span class="so-leitor-de-tela" data-detalhe-link-nome></span>
						<Seta direcao="direita" />
					</a>
				</div>
			</div>
		</nav>

		<div class="cabecalho__status">
			<Disponibilidade
				texto={perfil.modalidade}
				soPontoNoCelular
				rotulo={perfil.modalidadeCompleta}
			/>
		</div>
	</div>
</header>

<script>
	type Caixa = { w: number; h: number; r: number };
	type Nivel = 0 | 1 | 2;

	const ilha = document.querySelector<HTMLElement>("[data-ilha]");
	const q = <T extends HTMLElement>(seletor: string) => ilha?.querySelector<T>(seletor) ?? null;

	const fundo = q<HTMLElement>("[data-fundo]");
	const botao = q<HTMLButtonElement>(".ilha__botao");
	const atual = q<HTMLElement>("[data-atual]");
	const janelaNome = q<HTMLElement>("[data-janela-nome]");
	const lista = q<HTMLElement>("[data-lista]");
	const detalhe = q<HTMLElement>("[data-detalhe]");
	const marcador = q<HTMLElement>("[data-marcador]");
	const voltar = q<HTMLButtonElement>("[data-voltar]");
	const detalheNumero = q<HTMLElement>("[data-detalhe-numero]");
	const detalheNome = q<HTMLElement>("[data-detalhe-nome]");
	const detalheFrase = q<HTMLElement>("[data-detalhe-frase]");
	const detalheLink = q<HTMLAnchorElement>("[data-detalhe-link]");
	const detalheLinkNome = q<HTMLElement>("[data-detalhe-link-nome]");

	if (
		ilha &&
		fundo &&
		botao &&
		atual &&
		janelaNome &&
		lista &&
		detalhe &&
		marcador &&
		voltar &&
		detalheNumero &&
		detalheNome &&
		detalheFrase &&
		detalheLink &&
		detalheLinkNome
	) {
		const links = [...ilha.querySelectorAll<HTMLAnchorElement>(".ilha__link")];
		// O atraso escalonado de cada item vem daqui: a política de segurança não aceita style no HTML.
		links.forEach((link, i) => link.parentElement?.style.setProperty("--i", String(i)));
		const faixas = [...ilha.querySelectorAll<HTMLElement>("[data-faixa]")];
		const moveis = [...ilha.querySelectorAll<HTMLElement>("[data-mover]")];
		const nomesDaFaixa = [...janelaNome.querySelectorAll<HTMLElement>(".ilha__faixa-item")];
		const reduzir = matchMedia("(prefers-reduced-motion: reduce)");

		// Valores de movimento vêm dos tokens (src/styles/tokens.css).
		const estilo = getComputedStyle(ilha);
		const token = (nome: string) => estilo.getPropertyValue(nome).trim();
		const tempo = (nome: string) => {
			const v = token(nome);
			return v.endsWith("ms") ? parseFloat(v) : parseFloat(v) * 1000;
		};
		const SOBRA = parseFloat(token("--ilha-mola-sobra"));
		const PICO = parseFloat(token("--ilha-mola-pico"));
		const FOLGA = parseFloat(token("--ilha-folga-fundo"));
		const CRESCER = tempo("--ilha-crescer");
		const ENCOLHER = tempo("--ilha-encolher");
		const SUBIDA = token("--ilha-curva-subida");
		const ASSENTAR = token("--ilha-curva-assentar");

		let nivel: Nivel = 0;
		let indiceAtual = -1;
		let escolhido = 0;
		let fundoW = 0;
		let fundoH = 0;
		let alvo = "";
		let animacao: Animation | null = null;

		// ---------- tamanho de cada nível ----------
		const raioAberto = () => parseFloat(getComputedStyle(lista).borderTopLeftRadius) || 0;
		const caixaDo = (n: Nivel): Caixa => {
			if (n === 0)
				return { w: botao.offsetWidth, h: botao.offsetHeight, r: botao.offsetHeight / 2 };
			const vista = n === 1 ? lista : detalhe;
			return { w: vista.offsetWidth, h: vista.offsetHeight, r: raioAberto() };
		};

		// Recorte da caixa dentro do fundo: centralizado na largura, preso em cima.
		const recorte = (c: Caixa) => {
			const lado = (fundoW - c.w) / 2;
			const baixo = fundoH - FOLGA - c.h;
			return `inset(${FOLGA}px ${lado}px ${baixo}px ${lado}px round ${c.r}px)`;
		};

		// Lê o recorte que está na tela agora (no meio de uma animação, inclusive).
		const caixaNaTela = (): Caixa | null => {
			const valor = getComputedStyle(fundo).clipPath;
			const m = valor.match(/inset\(([^)]*?)(?:\s+round\s+([\d.]+)px[^)]*)?\)/);
			if (!m) return null;
			const n = m[1].trim().split(/\s+/).map(parseFloat);
			const [t, r = t, b = t, l = r] = n;
			return { w: fundoW - l - r, h: fundoH - t - b, r: parseFloat(m[2] ?? "0") };
		};

		// ---------- mola por movimento ----------
		const animar = () => !reduzir.matches && !ilha.hasAttribute("data-instantaneo");

		/** Leva o vidro até a caixa do nível. Devolve se cresceu (para o conteúdo acompanhar). */
		const morph = (para: Caixa, comMovimento: boolean) => {
			const fim = recorte(para);
			const de = caixaNaTela();
			const inicio = getComputedStyle(fundo).clipPath;
			animacao?.cancel();
			fundo.style.clipPath = fim;
			alvo = fim;
			if (!comMovimento || !de) return { cresceu: false, duracao: 0 };

			const dw = para.w - de.w;
			const dh = para.h - de.h;
			if (Math.abs(dw) < 0.5 && Math.abs(dh) < 0.5) return { cresceu: false, duracao: 0 };

			// A mola é melhoria: se o navegador recusar a animação, fica o recorte final, sem pulo.
			try {
				return animarRecorte(inicio, fim, para, dw, dh);
			} catch {
				animacao = null;
				return { cresceu: false, duracao: 0 };
			}
		};

		const animarRecorte = (inicio: string, fim: string, para: Caixa, dw: number, dh: number) => {
			if (dw > 0.5 || dh > 0.5) {
				// A sobra é sempre de SOBRA px, seja o passo de 10 px ou de 300 px.
				const passou = recorte({
					w: para.w + (dw > 0.5 ? SOBRA : 0),
					h: para.h + (dh > 0.5 ? SOBRA : 0),
					r: para.r,
				});
				animacao = fundo.animate(
					[
						{ clipPath: inicio, easing: SUBIDA },
						{ clipPath: passou, offset: PICO, easing: ASSENTAR },
						{ clipPath: fim },
					],
					{ duration: CRESCER },
				);
				return { cresceu: true, duracao: CRESCER };
			}

			animacao = fundo.animate([{ clipPath: inicio }, { clipPath: fim }], {
				duration: ENCOLHER,
				easing: SUBIDA,
			});
			return { cresceu: false, duracao: ENCOLHER };
		};

		// O fundo cobre o maior nível (inclusive o maior detalhe) mais a folga da mola.
		const preencherDetalhe = (i: number) => {
			const link = links[i];
			detalheNumero.textContent = link.dataset.numero ?? "";
			detalheNome.textContent = link.dataset.texto ?? "";
			detalheFrase.textContent = link.dataset.frase ?? "";
			detalheLink.href = link.getAttribute("href") ?? "#";
			detalheLinkNome.textContent = ` ${link.dataset.texto ?? ""}`;
		};

		const medirFundo = () => {
			let w = Math.max(botao.offsetWidth, lista.offsetWidth, detalhe.offsetWidth);
			let h = Math.max(botao.offsetHeight, lista.offsetHeight);
			links.forEach((_, i) => {
				preencherDetalhe(i);
				w = Math.max(w, detalhe.offsetWidth);
				h = Math.max(h, detalhe.offsetHeight);
			});
			preencherDetalhe(escolhido);
			fundoW = Math.ceil(w + 2 * FOLGA);
			fundoH = Math.ceil(h + 2 * FOLGA);
			fundo.style.inlineSize = `${fundoW}px`;
			fundo.style.blockSize = `${fundoH}px`;
			fundo.style.marginInlineStart = `${-fundoW / 2}px`;
			animacao?.cancel();
			alvo = recorte(caixaDo(nivel));
			fundo.style.clipPath = alvo;
		};

		// Mudou o tamanho do botão sem ser pela troca de seção (fonte carregou, por exemplo).
		new ResizeObserver(() => {
			if (nivel === 0 && recorte(caixaDo(0)) !== alvo) morph(caixaDo(0), false);
		}).observe(botao);
		addEventListener("resize", medirFundo);

		// ---------- níveis ----------
		const irPara = (n: Nivel, instantaneo: boolean) => {
			ilha.toggleAttribute("data-instantaneo", instantaneo);
			nivel = n;
			ilha.dataset.nivel = String(n);
			botao.setAttribute("aria-expanded", String(n > 0));
			morph(caixaDo(n), animar());
		};

		const linkAtual = () => links.find((l) => l.hasAttribute("aria-current")) ?? links[0];

		const abrir = (instantaneo: boolean) => {
			irPara(1, instantaneo);
			// O botão some dentro da ilha aberta: o foco vai para a seção atual.
			linkAtual().focus({ preventScroll: true });
		};

		const abrirDetalhe = (i: number, instantaneo: boolean) => {
			escolhido = i;
			preencherDetalhe(i);
			irPara(2, instantaneo);
			detalheLink.focus({ preventScroll: true });
		};

		const voltarALista = (instantaneo: boolean) => {
			irPara(1, instantaneo);
			links[escolhido].focus({ preventScroll: true });
		};

		const fechar = (instantaneo: boolean, devolverFoco = false) => {
			if (nivel === 0) return;
			irPara(0, instantaneo);
			if (devolverFoco) botao.focus({ preventScroll: true });
		};

		// detail 0: o clique veio do teclado (Enter ou espaço), então sem animação.
		botao.addEventListener("click", (e) => {
			if (nivel === 0) abrir(e.detail === 0);
		});
		// Sem JavaScript, cada item é um link comum para a seção. Com ele, o clique abre o detalhe.
		// Clique com Ctrl, Cmd, Shift ou botão do meio segue o link normal.
		links.forEach((link, i) =>
			link.addEventListener("click", (e) => {
				if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				e.preventDefault();
				abrirDetalhe(i, e.detail === 0);
			}),
		);
		voltar.addEventListener("click", (e) => voltarALista(e.detail === 0));
		for (const b of ilha.querySelectorAll<HTMLButtonElement>("[data-fechar]")) {
			b.addEventListener("click", (e) => fechar(e.detail === 0, true));
		}
		// "Ir para a seção": a página rola até lá (link comum) e a ilha volta à cápsula.
		detalheLink.addEventListener("click", (e) => fechar(e.detail === 0));

		// Setas, Home e End andam pela lista, sem sair dela.
		lista.addEventListener("keydown", (e) => {
			const i = links.indexOf(document.activeElement as HTMLAnchorElement);
			if (i < 0) return;
			const proximo = {
				ArrowDown: links[(i + 1) % links.length],
				ArrowUp: links[(i - 1 + links.length) % links.length],
				Home: links[0],
				End: links[links.length - 1],
			}[e.key];
			if (!proximo) return;
			e.preventDefault();
			proximo.focus({ preventScroll: true });
		});

		// Esc volta um nível por vez: detalhe → lista → cápsula.
		document.addEventListener("keydown", (e) => {
			if (e.key !== "Escape" || nivel === 0) return;
			if (nivel === 2) voltarALista(true);
			else fechar(true, true);
		});

		document.addEventListener("pointerdown", (e) => {
			if (nivel > 0 && !ilha.contains(e.target as Node)) fechar(false);
		});

		ilha.addEventListener("focusout", (e) => {
			const destino = e.relatedTarget as Node | null;
			if (nivel > 0 && destino && !ilha.contains(destino)) fechar(true);
		});

		// ---------- seção atual ----------
		const marcar = (i: number, comMovimento: boolean) => {
			if (i === indiceAtual) return;
			indiceAtual = i;
			const link = links[i];

			// Posição de cada peça da cápsula antes da troca (com o deslize em curso, se houver).
			const antes = moveis.map((el) => el.getBoundingClientRect().left);

			// A faixa desliza até a seção; se já estiver a caminho de outra, muda o destino no meio.
			for (const faixa of faixas)
				faixa.style.transform = `translateY(${(-100 * i) / links.length}%)`;
			janelaNome.style.inlineSize = `${nomesDaFaixa[i].offsetWidth}px`;
			atual.textContent = link.dataset.texto ?? "";
			for (const l of links) {
				if (l === link) l.setAttribute("aria-current", "location");
				else l.removeAttribute("aria-current");
			}
			marcador.style.transform = `translateY(${link.offsetTop}px)`;

			if (nivel !== 0) return;
			for (const el of moveis) el.getAnimations().forEach((a) => a.cancel());
			// Aqui não vale o "sem animação" do teclado: quem troca a seção é a rolagem.
			const { cresceu, duracao } = morph(caixaDo(0), comMovimento && !reduzir.matches);
			if (!duracao) return;

			// O número, o nome e o ponto acompanham a largura nova com a mesma mola do vidro.
			moveis.forEach((el, k) => {
				const dx = antes[k] - el.getBoundingClientRect().left;
				if (Math.abs(dx) < 0.5) return;
				const passou = cresceu ? (-Math.sign(dx) * SOBRA) / 2 : 0;
				el.animate(
					cresceu
						? [
								{ transform: `translateX(${dx}px)`, easing: SUBIDA },
								{ transform: `translateX(${passou}px)`, offset: PICO, easing: ASSENTAR },
								{ transform: "none" },
							]
						: [{ transform: `translateX(${dx}px)` }, { transform: "none" }],
					{ duration: duracao, easing: cresceu ? "linear" : SUBIDA },
				);
			});
		};

		// Seção atual: a que cruza a faixa do meio da tela. Quando o link aponta para o título
		// de uma seção (case), observa a seção inteira: no desktop o título fica oculto (1 px).
		const secoes = links
			.map((link) => {
				const id = decodeURIComponent((link.getAttribute("href") ?? "").split("#")[1] ?? "");
				const alvoSecao = id ? document.getElementById(id) : null;
				return { link, alvo: alvoSecao?.closest<HTMLElement>("section") ?? alvoSecao };
			})
			.filter((s): s is { link: HTMLAnchorElement; alvo: HTMLElement } => s.alvo !== null);

		// Pronta antes de medir: sem isso, a lista e o detalhe ainda estão escondidos (tamanho 0).
		ilha.setAttribute("data-pronta", "");
		marcar(0, false);
		medirFundo();
		// Com a fonte carregada, os nomes mudam de largura: mede de novo, sem animar.
		document.fonts.ready.then(() => {
			janelaNome.style.inlineSize = `${nomesDaFaixa[indiceAtual].offsetWidth}px`;
			marcador.style.transform = `translateY(${links[indiceAtual].offsetTop}px)`;
			medirFundo();
		});

		if (secoes.length > 0) {
			// Seção atual: a última cujo começo já passou da linha a 45% da altura da janela (a mesma
			// do sumário do case). O observador só avisa quando alguma seção cruza a faixa de cima;
			// a conta mede onde cada uma está agora. Assim uma seção curta, que nem chega à linha,
			// também é marcada (rodada 1f).
			let primeira = true;
			const observador = new IntersectionObserver(
				() => {
					const linha = innerHeight * 0.45;
					const ativa = secoes.filter((s) => s.alvo.getBoundingClientRect().top <= linha).at(-1);
					marcar(links.indexOf(ativa ? ativa.link : links[0]), !primeira);
					primeira = false;
				},
				{ rootMargin: "0px 0px -55% 0px" },
			);
			for (const s of secoes) observador.observe(s.alvo);
		}
	}
</script>

