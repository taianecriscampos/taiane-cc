---
/**
 * Rodapé de todas as páginas: nome e ano numa ponta, cidade na outra. Sem linha.
 */
import { perfil } from "../../dados/perfil";

const ano = new Date().getFullYear();
---

<footer class="rodape envoltorio">
	<p>
		{perfil.nome} @ <time datetime={String(ano)}>{ano}</time>
	</p>
	<p class="rodape__local">
		{perfil.cidade}
		<span class="rodape__ponto" aria-hidden="true"></span>
		<span class="so-leitor-de-tela">,</span>
		{perfil.estado}
	</p>
</footer>

<style>
	.rodape {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-pequeno) var(--space-medio);
		min-block-size: var(--rodape-altura);
		margin-block-start: var(--space-secao);
	}

	.rodape__local {
		display: inline-flex;
		align-items: center;
		gap: var(--space-pequeno);
	}

	.rodape__ponto {
		inline-size: var(--ponto-pequeno);
		block-size: var(--ponto-pequeno);
		border-radius: var(--radius-pilula);
		background: currentColor;
	}
</style>
