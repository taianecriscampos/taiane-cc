---
/**
 * Layout da página de case (personalidade inspirada na kora.framer.media).
 * Topo em toda a largura. Corpo: a partir de 1200 px, o sumário fixo na coluna da esquerda
 * (colunas 1 a 4) e o texto na coluna central (5 a 10).
 *
 * Sumário que se empilha (rodada 1e, pedido da Taiane):
 * - A seção que está sendo lida aparece com o título grande (32/40).
 * - As seções já lidas não somem: ficam pequenas (16/24, cor secundária), empilhadas acima da
 *   atual, e cada uma é um link que rola até a seção. As próximas ainda não aparecem.
 * - Rolando para cima, o caminho inverso.
 * - A troca anima só com transform (scale e translate) e opacity, em 300 ms, com a curva
 *   ease-out forte. Com movimento reduzido, troca sem animação.
 * - nav "Sumário do case", item atual com aria-current. Os h2 das seções continuam no HTML,
 *   visualmente ocultos no desktop, onde o sumário cumpre o papel.
 * O primeiro tópico é a Visão geral (resultados, Minha atuação, Desafio e Solução), com a
 * mesma lógica dos outros: título na coluna da esquerda, no sumário e na ilha.
 * Abaixo de 1200 px, sem sumário: o título de cada seção (32/40) fica acima do texto.
 * Linhas horizontais só entre as seções do texto; nenhuma entre o topo e "Contexto".
 * Nos cases sob sigilo, a nota de confidencialidade fecha a página.
 * O cabeçalho do site (ilha) também mostra as seções do case.
 */
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import { perfil } from "../../dados/perfil";
import { artigoDoCase } from "../../dados/dados-estruturados";
import { imagemPadrao, urlAbsoluta } from "../../dados/site";
import { encurtar, fraseDaSecao } from "../../dados/frase-da-secao";
import CabecalhoCase from "../blocos/CabecalhoCase.astro";
import FechamentoCase from "../blocos/FechamentoCase.astro";
import VisaoGeralCase from "../blocos/VisaoGeralCase.astro";
import LayoutBase from "./LayoutBase.astro";

interface Props {
	entrada: CollectionEntry<"cases">;
	headings: MarkdownHeading[];
}

const { entrada, headings } = Astro.props;
const dados = entrada.data;
const secoes = headings
	.filter((h) => h.depth === 2)
	.map((h) => ({ texto: h.text, href: `#${h.slug}` }));

/** O sumário começa pela Visão geral (resultados e resumo), depois os tópicos do texto. */
const sumario = [{ texto: "Visão geral", href: "#visao-geral" }, ...secoes];

// Imagem de compartilhamento: a capa do case em 1200 px; sem capa, a imagem padrão.
const capaOg = dados.capa
	? await getImage({ src: dados.capa.src, width: 1200, format: "jpg", quality: 80 })
	: undefined;
const imagemOg = capaOg
	? { url: urlAbsoluta(capaOg.src), alt: dados.capa!.alt }
	: { url: urlAbsoluta(imagemPadrao.caminho), alt: imagemPadrao.alt };
const caminho = `/cases/${entrada.id}/`;

// Tempo de leitura: 200 palavras por minuto, sem contar marcação e comentários.
const palavras = (entrada.body ?? "")
	.replace(/<!--[\s\S]*?-->/g, " ")
	.replace(/<[^>]+>/g, " ")
	.split(/\s+/)
	.filter((p) => /[\p{L}\p{N}]/u.test(p)).length;
const minutos = Math.max(1, Math.ceil(palavras / 200));

/*
 * O Markdown chega como HTML corrido. Cada título de nível 2 abre uma seção:
 * <section> com o título e um bloco com o texto.
 * O que vem antes do primeiro título (só comentários) fica de fora.
 */
const html = await Astro.slots.render("default");
const partes = html
	.split(/(?=<h2[\s>])/)
	.filter((parte) => parte.startsWith("<h2"))
	.map((parte) => {
		const fim = parte.indexOf("</h2>") + "</h2>".length;
		return { titulo: parte.slice(0, fim), texto: parte.slice(fim) };
	});
const corpo = partes
	.map(
		({ titulo, texto }) =>
			`<section class="case-secao">${titulo}<div class="case-secao__texto">${texto}</div></section>`,
	)
	.join("");

// Ilha, nível 3: cada seção com a primeira frase do próprio texto (encurtada se passar de 80
// caracteres). A Visão geral usa a primeira frase do resumo.
const secoesDaIlha = secoes.map((s, i) => ({ ...s, frase: fraseDaSecao(partes[i]?.texto ?? "") }));
const visaoGeralDaIlha = {
	texto: "Visão geral",
	href: "#visao-geral",
	frase: encurtar(dados.resumo.match(/^.+?[.!?](?=\s|$)/)?.[0] ?? dados.resumo),
};
---

<LayoutBase
	titulo={`${dados.titulo} · ${perfil.nome}`}
	descricao={dados.resumo}
	secoesDoCase={secoesDaIlha}
	inicioDoCase={visaoGeralDaIlha}
	tipo="article"
	imagem={imagemOg}
	dadosEstruturados={artigoDoCase({
		titulo: dados.titulo,
		resumo: dados.resumo,
		caminho,
		imagem: imagemOg.url,
		publicadoEm: dados.publicadoEm,
	})}
>
	<article class="case envoltorio">
		<div class="case__topo">
			<CabecalhoCase
				titulo={dados.titulo}
				resumo={dados.resumo}
				empresa={dados.empresa}
				ano={dados.ano}
				papel={dados.papel}
				duracao={dados.duracao}
				disciplinas={dados.disciplinas}
				imagem={dados.capa}
				minutos={minutos}
				sigilo={dados.sigilo}
				rascunhos={dados.rascunhos}
			/>
		</div>

		<div class="case__corpo">
			<nav class="sumario" aria-label="Sumário do case" data-sumario>
				<ol class="sumario__lista" role="list">
					{sumario.map((secao, i) => (
						<li class="sumario__item" data-estado={i === 0 ? "atual" : "proxima"}>
							<a
								class="sumario__link"
								href={secao.href}
								aria-current={i === 0 ? "location" : undefined}
							>
								{secao.texto}
								<span class="sumario__realce" aria-hidden="true">
									{secao.texto}
								</span>
							</a>
						</li>
					))}
				</ol>
			</nav>
			<div class="case__secoes">
				<section class="case-secao">
					<h2 id="visao-geral">Visão geral</h2>
					<div class="case-secao__texto">
						<VisaoGeralCase
							resultados={dados.resultados}
							cartoes={dados.cartoes}
							rascunhos={dados.rascunhos}
						/>
					</div>
				</section>
				<Fragment set:html={corpo} />
			</div>
		</div>

		{dados.sigilo === "confidencial" && (
			<div class="case__central case__fim">
				<FechamentoCase />
			</div>
		)}
	</article>
</LayoutBase>

<script>
	/*
	 * Sumário que se empilha. Uma linha imaginária a 45% da altura da janela (a mesma da ilha) decide a
	 * seção atual: a última seção que já cruzou essa linha. O IntersectionObserver avisa quando alguma
	 * seção cruza a faixa acima da linha; não há cálculo a cada rolagem.
	 *
	 * Movimento (sem mola, ease-out forte, cerca de 350 ms, só transform e opacity):
	 * - O título que sai encolhe por escala a partir do canto, e o realce (texto principal por cima
	 *   do secundário) esmaece ao mesmo tempo: a cor muda sem animar a propriedade color.
	 * - Os itens que continuam deslizam para o novo lugar (FLIP). O título novo entra com opacidade e
	 *   um deslize curto; quem sai (rolando para cima) esmaece e desce numa cópia sem leitor de tela.
	 * - Rolagem rápida: espera curta (ESPERA) para a seção se firmar e vai direto até a final. Uma
	 *   troca no meio parte de onde cada item está naquele instante, sem pulo.
	 * - Movimento reduzido ou sumário escondido (abaixo de 1200 px): troca instantânea, sem espera.
	 */
	const ESPERA = 100;
	const nav = document.querySelector<HTMLElement>("[data-sumario]");
	const itens = [...(nav?.querySelectorAll<HTMLLIElement>(".sumario__item") ?? [])];
	const secoes = itens.map((item) => {
		const alvo = item.querySelector("a")?.getAttribute("href") ?? "";
		return document.getElementById(decodeURIComponent(alvo.slice(1)))?.closest("section") ?? null;
	});
	const reduzido = matchMedia("(prefers-reduced-motion: reduce)");
	const raiz = getComputedStyle(document.documentElement);
	const token = (nome: string) => raiz.getPropertyValue(nome).trim();
	const emMs = (valor: string) => parseFloat(valor) * (valor.endsWith("ms") ? 1 : 1000);
	const emPx = (valor: string) =>
		parseFloat(valor) * (valor.endsWith("rem") ? parseFloat(raiz.fontSize) : 1);
	const opcoes: KeyframeAnimationOptions = {
		duration: emMs(token("--sumario-duracao")) || 350,
		easing: token("--sumario-curva") || "ease-out",
	};
	const deslize = emPx(token("--sumario-deslize")) || 8;
	let atual = 0;

	type Foto = {
		estado: string;
		caixa: DOMRect;
		escala: number;
		letra: number;
		opacidade: number;
		transform: string;
		topo: number;
		esquerda: number;
		largura: number;
	};

	/** Como o item aparece agora, com a animação em curso, se houver. */
	const fotografar = (item: HTMLLIElement): Foto | null => {
		if (item.dataset.estado === "proxima") return null;
		const estilo = getComputedStyle(item);
		const caixa = item.getBoundingClientRect();
		return {
			estado: item.dataset.estado ?? "lida",
			caixa,
			escala: item.offsetWidth ? caixa.width / item.offsetWidth : 1,
			letra: parseFloat(estilo.fontSize),
			opacidade: parseFloat(estilo.opacity),
			transform: estilo.transform === "none" ? "" : estilo.transform,
			topo: item.offsetTop,
			esquerda: item.offsetLeft,
			largura: item.offsetWidth,
		};
	};

	/** Quem sai do sumário esmaece e desce numa cópia; o item de verdade já está escondido. */
	const sair = (item: HTMLLIElement, foto: Foto) => {
		if (!nav) return;
		const copia = item.cloneNode(true) as HTMLLIElement;
		copia.dataset.estado = foto.estado;
		copia.setAttribute("aria-hidden", "true");
		copia.inert = true;
		Object.assign(copia.style, {
			position: "absolute",
			insetBlockStart: `${foto.topo}px`,
			insetInlineStart: `${foto.esquerda}px`,
			inlineSize: `${foto.largura}px`,
			pointerEvents: "none",
		});
		nav.append(copia);
		const de = foto.transform || "none";
		copia
			.animate(
				[
					{ opacity: foto.opacidade, transform: de },
					{ opacity: 0, transform: `${foto.transform} translateY(${deslize}px)` },
				],
				opcoes,
			)
			.finished.finally(() => copia.remove());
	};

	/** Mostra a seção `indice` como atual: as de antes ficam pequenas e as de depois somem. */
	const marcar = (indice: number, animar: boolean) => {
		if (indice === atual) return;
		const antes = itens.map(fotografar);
		itens.forEach((item, i) => {
			item.dataset.estado = i < indice ? "lida" : i === indice ? "atual" : "proxima";
			const link = item.querySelector("a");
			if (i === indice) link?.setAttribute("aria-current", "location");
			else link?.removeAttribute("aria-current");
		});
		atual = indice;

		itens.forEach((item, i) => {
			item.getAnimations().forEach((a) => a.cancel());
			if (!animar) return;
			const foto = antes[i];
			if (item.dataset.estado === "proxima") {
				if (foto) sair(item, foto);
				return;
			}
			if (!foto) {
				item.animate(
					[
						{ opacity: 0, transform: `translateY(${deslize}px)` },
						{ opacity: 1, transform: "none" },
					],
					opcoes,
				);
				return;
			}
			// FLIP: do jeito que estava (lugar, tamanho visível e opacidade) até o novo lugar.
			const caixa = item.getBoundingClientRect();
			const escala = (foto.letra * foto.escala) / parseFloat(getComputedStyle(item).fontSize);
			const dx = foto.caixa.left - caixa.left;
			const dy = foto.caixa.top - caixa.top;
			if (
				Math.abs(escala - 1) < 0.001 &&
				Math.abs(dx) < 0.5 &&
				Math.abs(dy) < 0.5 &&
				foto.opacidade === 1
			)
				return;
			item.animate(
				[
					{ opacity: foto.opacidade, transform: `translate(${dx}px, ${dy}px) scale(${escala})` },
					{ opacity: 1, transform: "none" },
				],
				opcoes,
			);
		});
	};

	if (nav && secoes.every(Boolean)) {
		/** A conta mede onde cada seção está agora: um salto grande também acerta a seção atual. */
		const secaoAtual = () => {
			const linha = innerHeight * 0.45;
			let indice = 0;
			secoes.forEach((s, i) => {
				if (s && s.getBoundingClientRect().top <= linha) indice = i;
			});
			return indice;
		};
		let espera: ReturnType<typeof setTimeout> | undefined;
		let primeira = true;
		const observador = new IntersectionObserver(
			() => {
				clearTimeout(espera);
				const animar = !primeira && !reduzido.matches && nav.offsetParent !== null;
				primeira = false;
				if (!animar) marcar(secaoAtual(), false);
				else espera = setTimeout(() => marcar(secaoAtual(), true), ESPERA);
			},
			// Faixa do topo da janela até a linha a 45% da altura, a mesma da ilha.
			{ rootMargin: "0px 0px -55% 0px" },
		);
		for (const s of secoes) if (s) observador.observe(s);

		// Clique num item: rolagem suave até a seção (instantânea com movimento reduzido). O foco vai
		// para o título da seção, para o teclado continuar dali.
		nav.addEventListener("click", (e) => {
			const link = (e.target as Element).closest<HTMLAnchorElement>(".sumario__link");
			if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			const alvo = document.getElementById(decodeURIComponent(link.hash.slice(1)));
			if (!alvo) return;
			e.preventDefault();
			alvo.scrollIntoView({ behavior: reduzido.matches ? "instant" : "smooth", block: "start" });
			history.pushState(null, "", link.hash);
			if (!alvo.hasAttribute("tabindex")) alvo.setAttribute("tabindex", "-1");
			alvo.focus({ preventScroll: true });
		});
	}
</script>

<style>
	.case {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		column-gap: var(--grade-espaco);
		padding-block: var(--space-bloco) var(--space-secao);
	}

	.case__topo {
		grid-column: 1 / -1;
	}

	/* O texto começa com espaço largo depois do topo, sem linha: a tipografia já separa. */
	.case__corpo {
		margin-block-start: var(--space-maximo);
	}

	/* Sumário: só a partir de 1200 px. */
	.sumario {
		display: none;
	}

	/* Linhas só ENTRE as seções do texto, com 48 px acima e abaixo. */
	.case__secoes :global(.case-secao + .case-secao),
	.case__fim {
		margin-block-start: var(--space-largo);
		padding-block-start: var(--space-largo);
		border-block-start: var(--divisoria);
	}

	.case__secoes :global(.case-secao) {
		display: grid;
		gap: var(--space-grande);
	}

	/* Título de seção do case: 32/40, peso 500. Pelo sumário ou pela ilha, a seção para abaixo
	   do cabeçalho. */
	.case__secoes :global(h2) {
		scroll-margin-block-start: calc(var(--cabecalho-altura) + var(--space-maior));
		font-size: var(--text-titulo-cartao);
		letter-spacing: var(--tracking-titulo-cartao);
		font-weight: var(--peso-titulo);
		line-height: var(--leading-titulo-cartao);
	}

	/* Moldura das imagens do texto: cantos arredondados e fundo de cor suave. */
	.case__secoes :global(figure),
	.case__secoes :global(p:has(> img:only-child)) {
		margin: 0;
		padding: var(--moldura-espaco);
		border-radius: var(--moldura-raio);
		background: var(--moldura-fundo);
	}

	/* Regra de raios (rodada 1c): 24 px na moldura, 8 px na imagem de dentro. */
	.case__secoes :global(p > img:only-child),
	.case__secoes :global(figure img) {
		inline-size: 100%;
		border-radius: var(--radius-imagem-interna);
	}

	/* Texto corrido do Markdown. :global porque o HTML vem do conteúdo, não deste arquivo. */
	.case__secoes :global(.case-secao__texto) {
		display: grid;
		align-content: start;
		gap: var(--space-medio);
		min-inline-size: 0;
	}

	/* O bloco de conteúdo de exemplo não muda o ritmo: os parágrafos de dentro seguem a grade. */
	.case__secoes :global(.case-secao__texto > [data-rascunho]) {
		display: contents;
	}

	/* Subtítulo dentro da seção: texto de destaque (20/28), peso 500. */
	.case__secoes :global(h3) {
		margin-block-start: var(--space-grande);
		font-size: var(--text-destaque);
		font-weight: var(--peso-titulo);
		letter-spacing: var(--tracking-destaque);
		line-height: var(--leading-destaque);
	}

	.case__secoes :global(.case-secao__texto > h3:first-child) {
		margin-block-start: 0;
	}

	/* Só as listas do texto do artigo (filhas diretas), não as da Visão geral. */
	.case__secoes :global(.case-secao__texto > ul),
	.case__secoes :global(.case-secao__texto > ol) {
		display: grid;
		gap: var(--space-minimo);
		padding-inline-start: var(--space-grande);
	}

	.case__secoes :global(strong) {
		font-weight: var(--peso-forte);
	}

	/* A frase-chave da seção, em citação: texto de destaque (20/28) em azul. */
	.case__secoes :global(blockquote) {
		color: var(--color-destaque-case);
		font-size: var(--text-destaque);
		letter-spacing: var(--tracking-destaque);
		line-height: var(--leading-destaque);
	}

	@media (min-width: 768px) {
		.case {
			grid-template-columns: repeat(var(--grade-colunas), minmax(0, 1fr));
		}

		.case__central,
		.case__corpo {
			grid-column: 2 / span 10;
		}
	}

	@media (min-width: 1200px) {
		.case__central {
			grid-column: 4 / span 6;
		}

		.case__corpo {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: repeat(var(--grade-colunas), minmax(0, 1fr));
			column-gap: var(--grade-espaco);
			align-items: start;
		}

		.case__secoes {
			grid-column: 5 / span 6;
		}

		.case__secoes :global(.case-secao) {
			position: relative;
		}

		/* O h2 continua no HTML para o leitor de tela e para os links; o sumário mostra o título. */
		.case__secoes :global(h2) {
			position: absolute;
			inline-size: 1px;
			block-size: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.sumario {
			display: block;
			grid-column: 1 / span 4;
			grid-row: 1;
			position: sticky;
			inset-block-start: calc(var(--cabecalho-altura) + var(--space-grande));
		}

		.sumario__lista {
			display: grid;
			gap: var(--space-pequeno);
			padding: 0;
			list-style: none;
		}

		/* Já lida: pequena (16/24), cor secundária, link para voltar à seção. */
		.sumario__item {
			transform-origin: left top;
			font-size: var(--text-corpo);
			line-height: var(--leading-corpo);
			/* Peso e espaço entre letras mudam aos poucos, junto com o encolher (a fonte é variável).
			   Exceção à regra "só transform e opacity", pedida pela Taiane: só nestes itens, e só
			   durante a troca de seção. */
			transition:
				font-weight var(--sumario-duracao) var(--sumario-curva),
				letter-spacing var(--sumario-duracao) var(--sumario-curva);
		}

		.sumario__item[data-estado="proxima"] {
			display: none;
		}

		/* Atual: título de seção (32/40), peso 500. */
		.sumario__item[data-estado="atual"] {
			font-size: var(--text-titulo-cartao);
			font-weight: var(--peso-titulo);
			letter-spacing: var(--tracking-titulo-cartao);
			line-height: var(--leading-titulo-cartao);
		}

		/* O texto fica no secundário; o realce, o mesmo texto no principal por cima, aparece no
		   título atual. A cor muda por opacidade, junto com o encolher. */
		.sumario__link {
			position: relative;
			display: inline-block;
			color: var(--color-texto-secundario);
			text-decoration: none;
			transition: transform var(--sumario-hover-duracao) var(--sumario-curva);
		}

		.sumario__realce {
			position: absolute;
			inset: 0;
			color: var(--color-texto);
			opacity: 0;
			transition: opacity var(--sumario-duracao) var(--sumario-curva);
		}

		.sumario__item[data-estado="atual"] .sumario__realce {
			opacity: 1;
		}
	}

	/* Hover só com mouse: o item lido vai para o texto principal e desliza 2 px. */
	@media (min-width: 1200px) and (hover: hover) and (pointer: fine) {
		.sumario__item[data-estado="lida"] .sumario__link:hover {
			transform: translateX(var(--sumario-hover-deslize));
		}

		.sumario__item[data-estado="lida"] .sumario__link:hover .sumario__realce {
			opacity: 1;
			transition-duration: var(--sumario-hover-duracao);
		}
	}
</style>
