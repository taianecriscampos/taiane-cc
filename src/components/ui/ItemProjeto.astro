---
/**
 * Uma linha da lista de projetos. A linha inteira é clicável, mas só o título é o link:
 * o leitor de tela anuncia um link por projeto, com o nome dele.
 */
interface Props {
	titulo: string;
	empresa: string;
	ano: number;
	chamada: string;
	href: string;
	/** Nível do título. 3 na página inicial (dentro de "Projetos"). */
	nivel?: 2 | 3;
}

const { titulo, empresa, ano, chamada, href, nivel = 3 } = Astro.props;
const Titulo = `h${nivel}` as const;
---

<li class="item-projeto">
	<Titulo class="item-projeto__titulo">
		<a href={href}>{titulo}</a>
	</Titulo>
	<p class="item-projeto__empresa">{empresa}</p>
	<p class="item-projeto__ano">
		<time datetime={String(ano)}>{ano}</time>
	</p>
	<p class="item-projeto__chamada">{chamada}</p>
</li>

<style>
	.item-projeto {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: var(--space-minimo) var(--space-medio);
		padding-block: var(--bloco-espaco);
		border-block-start: var(--bloco-separador);
	}

	.item-projeto__titulo {
		grid-column: 1 / -1;
		font-size: var(--text-titulo-3);
	}

	.item-projeto__titulo a {
		text-decoration: none;
	}

	/* Estende a área de clique do link para a linha toda. */
	.item-projeto__titulo a::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.item-projeto__titulo a:focus-visible {
		outline: none;
	}

	.item-projeto__titulo a:focus-visible::after {
		outline: var(--focus-espessura) solid var(--focus-cor);
		outline-offset: var(--focus-afastamento);
	}

	.item-projeto__empresa,
	.item-projeto__chamada {
		color: var(--color-texto-secundario);
	}

	.item-projeto__ano {
		color: var(--color-texto-terciario);
	}

	.item-projeto__chamada {
		grid-column: 1 / -1;
	}

	@media (min-width: 64rem) {
		.item-projeto {
			grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 2fr) auto;
			align-items: baseline;
		}

		.item-projeto__titulo {
			grid-column: 1;
			grid-row: 1 / span 2;
		}

		.item-projeto__chamada {
			grid-column: 2;
			grid-row: 1;
		}

		.item-projeto__empresa {
			grid-column: 3;
			grid-row: 1;
		}

		.item-projeto__ano {
			grid-column: 4;
			grid-row: 1;
		}
	}
</style>
