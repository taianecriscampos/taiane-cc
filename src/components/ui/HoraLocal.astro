---
/**
 * Hora local, em fonte mono. A hora entra por script; o nome do fuso fica sempre visível.
 */
interface Props {
	fuso: string;
	nomeDoFuso: string;
}

const { fuso, nomeDoFuso } = Astro.props;
---

<p class="hora-local">
	<time class="hora-local__valor" data-hora-fuso={fuso} hidden></time>
	<span>{nomeDoFuso}</span>
</p>

<script>
	import { iniciarHoraLocal } from "../../scripts/hora-local";
	iniciarHoraLocal();
</script>

<style>
	.hora-local {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-pequeno);
		color: var(--color-texto-secundario);
	}

	.hora-local__valor {
		color: var(--color-texto);
	}
</style>
