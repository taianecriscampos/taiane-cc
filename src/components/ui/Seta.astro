---
/**
 * Seta desenhada para o site, solta, sem fundo, numa área de toque redonda.
 * É decorativa: o texto do link ao lado diz para onde vai.
 * "grande" (48 px) para o botão da abertura; "pequeno" (40 px) para links e listas.
 */
interface Props {
	direcao?: "baixo" | "diagonal";
	tamanho?: "pequeno" | "grande";
}

const { direcao = "diagonal", tamanho = "pequeno" } = Astro.props;
---

<span class="seta" data-tamanho={tamanho} aria-hidden="true">
	<svg
		class="seta__icone"
		viewBox="0 0 20 20"
		width="20"
		height="20"
		focusable="false"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		{direcao === "baixo" ? (
			<path d="M10 3.5v13M4.5 11 10 16.5 15.5 11" />
		) : (
			<path d="M5.5 14.5l9-9M7 5.5h7.5V13" />
		)}
	</svg>
</span>

<style>
	.seta {
		display: inline-grid;
		flex: none;
		place-items: center;
		inline-size: var(--circulo-pequeno);
		block-size: var(--circulo-pequeno);
		border-radius: var(--radius-pilula);
		color: var(--color-texto);
	}

	.seta[data-tamanho="grande"] {
		inline-size: var(--circulo-grande);
		block-size: var(--circulo-grande);
	}

	.seta__icone {
		inline-size: var(--seta-tamanho);
		block-size: var(--seta-tamanho);
		transition: transform var(--motion-duration-base) var(--motion-ease-out);
	}
</style>
