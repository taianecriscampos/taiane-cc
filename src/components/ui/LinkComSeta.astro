---
/**
 * Link de texto com a seta ao lado, como "Me encontre no LinkedIn".
 * A seta fica dentro do link: a área de toque inclui os dois.
 * Externo: abre em nova aba e avisa o leitor de tela.
 * textoCurto: aparece no lugar do texto até 767 px, quando o texto inteiro não cabe.
 */
import Seta from "./Seta.astro";

interface Props {
	href: string;
	texto: string;
	textoCurto?: string;
	direcao?: "diagonal" | "direita" | "baixo";
	externo?: boolean;
	/** Só para o leitor de tela, depois do texto: diz o destino quando o texto não diz. */
	complemento?: string;
}

const { href, texto, textoCurto, direcao = "diagonal", externo = false, complemento } = Astro.props;
---

<a
	class="link-com-seta"
	href={href}
	target={externo ? "_blank" : undefined}
	rel={externo ? "noopener noreferrer" : undefined}
>
	{textoCurto ? (
		<span class="link link-com-seta__texto">
			<span class="link-com-seta__curto">{textoCurto}</span>
			<span class="link-com-seta__longo">{texto}</span>
		</span>
	) : (
		<span class="link link-com-seta__texto">{texto}</span>
	)}
	{complemento && <span class="so-leitor-de-tela">, {complemento}</span>}
	{externo && <span class="so-leitor-de-tela"> — abre em nova aba</span>}
	<Seta direcao={direcao} />
</a>

<style>
	.link-com-seta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-nenhum);
		color: var(--link-cor);
		text-decoration: none;
	}

	/* O sublinhado do texto acompanha o hover e o foco do link inteiro. */
	.link-com-seta:focus-visible .link-com-seta__texto::after {
		transform: scaleX(1);
	}

	.link-com-seta__longo {
		display: none;
	}

	@media (min-width: 768px) {
		.link-com-seta__curto {
			display: none;
		}

		.link-com-seta__longo {
			display: inline;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.link-com-seta:hover .link-com-seta__texto::after {
			transform: scaleX(1);
		}
	}
</style>
