---
/**
 * Link de texto com a seta ao lado, como "Me encontre no LinkedIn".
 * A seta fica dentro do link: a área de toque inclui os dois.
 * Externo: abre em nova aba e avisa o leitor de tela.
 * textoCurto: aparece no lugar do texto até 767 px, quando o texto inteiro não cabe.
 * noTexto: variante para links DENTRO de um parágrafo. Mesma altura de linha do texto, sem área de
 * toque mínima, e a seta (pequena, sem círculo) e a pontuação seguinte ficam coladas na palavra,
 * sem quebra de linha entre elas. Continua abrindo em nova aba, com o aviso para o leitor de tela.
 */
import Seta from "./Seta.astro";

interface Props {
	href: string;
	texto: string;
	textoCurto?: string;
	direcao?: "diagonal" | "direita" | "baixo";
	externo?: boolean;
	/** Só para o leitor de tela, depois do texto: diz o destino quando o texto não diz. */
	complemento?: string;
	/** Link dentro de um parágrafo (ver acima). */
	noTexto?: boolean;
	/** Só com noTexto: vírgula, ponto etc. que vem logo depois do link e não pode se separar dele. */
	pontuacao?: string;
}

const {
	href,
	texto,
	textoCurto,
	direcao = "diagonal",
	externo = false,
	complemento,
	noTexto = false,
	pontuacao = "",
} = Astro.props;
---

{noTexto ? (
	<span class="link-no-texto__cola">
		<a
			class="link-no-texto"
			href={href}
			target={externo ? "_blank" : undefined}
			rel={externo ? "noopener noreferrer" : undefined}
		>
			<span class="link">{texto}</span>
			{externo && <span class="so-leitor-de-tela"> — abre em nova aba</span>}
			<svg
				class="link-no-texto__seta"
				viewBox="0 0 20 20"
				aria-hidden="true"
				focusable="false"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				{direcao === "baixo" && <path d="M10 3.5v13M4.5 11 10 16.5 15.5 11" />}
				{direcao === "direita" && <path d="M3.5 10h13M11 4.5 16.5 10 11 15.5" />}
				{direcao === "diagonal" && <path d="M5.5 14.5l9-9M7 5.5h7.5V13" />}
			</svg>
		</a>
		{pontuacao}
	</span>
) : (
	<a
		class="link-com-seta"
		href={href}
		target={externo ? "_blank" : undefined}
		rel={externo ? "noopener noreferrer" : undefined}
	>
		{textoCurto ? (
			<span class="link link-com-seta__texto">
				<span class="link-com-seta__curto">{textoCurto}</span>
				<span class="link-com-seta__longo">{texto}</span>
			</span>
		) : (
			<span class="link link-com-seta__texto">{texto}</span>
		)}
		{complemento && <span class="so-leitor-de-tela">, {complemento}</span>}
		{externo && <span class="so-leitor-de-tela"> — abre em nova aba</span>}
		<Seta direcao={direcao} />
	</a>
)}

<style>
	/* noTexto: tudo numa palavra só para a quebra de linha; a altura vem do parágrafo. */
	.link-no-texto__cola {
		white-space: nowrap;
	}

	.link-no-texto {
		color: var(--link-cor);
		text-decoration: none;
	}

	.link-no-texto:focus-visible .link::after {
		transform: scaleX(1);
	}

	.link-no-texto__seta {
		display: inline-block;
		inline-size: 0.75em;
		block-size: 0.75em;
		margin-inline-start: 0.125em;
		vertical-align: baseline;
	}

	@media (hover: hover) and (pointer: fine) {
		.link-no-texto:hover .link::after {
			transform: scaleX(1);
		}
	}

	.link-com-seta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-nenhum);
		color: var(--link-cor);
		text-decoration: none;
	}

	/* O sublinhado do texto acompanha o hover e o foco do link inteiro. */
	.link-com-seta:focus-visible .link-com-seta__texto::after {
		transform: scaleX(1);
	}

	.link-com-seta__longo {
		display: none;
	}

	@media (min-width: 768px) {
		.link-com-seta__curto {
			display: none;
		}

		.link-com-seta__longo {
			display: inline;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.link-com-seta:hover .link-com-seta__texto::after {
			transform: scaleX(1);
		}
	}
</style>
