---
/**
 * Selo próprio do taiane.cc: texto em círculo, em vermelho de marca.
 * Decorativo e escondido do leitor de tela: o nome e o cargo já estão na página.
 * Parado por enquanto; a rotação entra na etapa 0.5.0.
 * O texto ocupa a volta inteira do círculo (textLength = 2πr, com r = 36).
 */
interface Props {
	id?: string;
}

const { id = "selo" } = Astro.props;
const caminho = `${id}-caminho`;
---

<svg class="selo" viewBox="0 0 96 96" width="96" height="96" aria-hidden="true" focusable="false">
	<circle class="selo__fundo" cx="48" cy="48" r="48"></circle>
	<path id={caminho} d="M48 12a36 36 0 1 1 0 72a36 36 0 1 1 0-72" fill="none"></path>
	<text class="selo__texto" font-size="12">
		<textPath href={`#${caminho}`} textLength="226" lengthAdjust="spacing">
			taiane.cc · design engineer ·
		</textPath>
	</text>
	<circle class="selo__centro" cx="48" cy="48" r="5"></circle>
</svg>

<style>
	.selo {
		inline-size: var(--selo-tamanho);
		block-size: var(--selo-tamanho);
	}

	.selo__fundo {
		fill: var(--selo-fundo);
	}

	.selo__texto {
		fill: var(--selo-cor);
		font-weight: var(--peso-titulo);
	}

	.selo__centro {
		fill: var(--selo-cor);
	}
</style>
