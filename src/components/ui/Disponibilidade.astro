---
/**
 * Modelo de trabalho com o ponto verde de "online", que pulsa devagar e sem parar.
 * O pulso é um anel que cresce e some (só transform e opacity). Com redução de movimento,
 * o ponto fica parado. O ponto é decorativo: o texto ao lado diz o mesmo.
 *
 * Com `textoCurto`, o celular (até 767 px) mostra só ele e, de 768 px em diante, o texto inteiro.
 * Com `rotulo`, o leitor de tela lê a frase completa no lugar do que aparece na tela.
 * (Um aria-label num parágrafo seria ignorado por vários leitores de tela, por isso o texto
 * escondido da tela.)
 */
import { perfil } from "../../dados/perfil";

interface Props {
	texto?: string;
	textoCurto?: string;
	rotulo?: string;
}

const { texto = perfil.modalidade, textoCurto, rotulo } = Astro.props;
---

<p class="disponibilidade">
	<span class="disponibilidade__ponto" aria-hidden="true"></span>
	<span aria-hidden={rotulo ? "true" : undefined}>
		{textoCurto ? (
			<>
				<span class="disponibilidade__curto">{textoCurto}</span>
				<span class="disponibilidade__longo">{texto}</span>
			</>
		) : (
			texto
		)}
	</span>
	{rotulo && <span class="so-leitor-de-tela">{rotulo}</span>}
</p>

<style>
	.disponibilidade {
		display: inline-flex;
		align-items: center;
		gap: var(--space-pequeno);
	}

	.disponibilidade__longo {
		display: none;
	}

	.disponibilidade__ponto {
		position: relative;
		flex: none;
		inline-size: var(--status-ponto);
		block-size: var(--status-ponto);
		border-radius: var(--radius-pilula);
		background: var(--status-cor);
	}

	.disponibilidade__ponto::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: inherit;
		animation: pulso var(--motion-duration-pulso) var(--motion-ease-out) infinite;
	}

	@keyframes pulso {
		from {
			opacity: 0.6;
			transform: scale(1);
		}
		to {
			opacity: 0;
			transform: scale(2.5);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.disponibilidade__ponto::after {
			animation: none;
			opacity: 0;
		}
	}

	@media (min-width: 768px) {
		.disponibilidade__curto {
			display: none;
		}

		.disponibilidade__longo {
			display: inline;
		}
	}
</style>
