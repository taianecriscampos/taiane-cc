---
/**
 * Projetos em blocos bento: cartões arredondados de fundo cinza claro, sem borda e sem sombra.
 * O primeiro case ganha o bloco grande, com espaço para a imagem; os outros ficam empilhados ao lado.
 * O título é o link, esticado para o cartão inteiro: o leitor de tela anuncia um link por projeto.
 * Sem chamada, o cartão mostra o texto-modelo no estilo de rascunho, marcando o lugar do conteúdo.
 */
import Seta from "../ui/Seta.astro";
import type { Entrada } from "../ui/Entrada.astro";

interface Props {
	entradas: Entrada[];
	/** Muda o id quando o bloco aparece mais de uma vez (Laboratório). */
	id?: string;
	rotulo?: string;
}

const { entradas, id = "projetos", rotulo = "Projetos" } = Astro.props;
---

<section class="secao envoltorio" id={id} aria-labelledby={`${id}-titulo`}>
	<h2 id={`${id}-titulo`} class="secao__rotulo">
		{rotulo}
	</h2>
	<ul class="bento" role="list">
		{entradas.map((e, i) => (
			<li class="bento__item" data-tamanho={i === 0 ? "grande" : "pequeno"}>
				{i === 0 && (
					<div class="bento__imagem">
						<p class="marcador">[IMAGEM DO CASE]</p>
					</div>
				)}
				<div class="bento__texto">
					<h3 class="bento__titulo">
						<a
							class="bento__link"
							href={e.href}
							target={e.externo ? "_blank" : undefined}
							rel={e.externo ? "noopener noreferrer" : undefined}
						>
							{e.titulo}
							{e.externo && <span class="so-leitor-de-tela"> — abre em nova aba</span>}
						</a>
					</h3>
					{e.descricao ? (
						<p class="bento__descricao">{e.descricao}</p>
					) : (
						<p class="marcador">[Chamada do case: uma frase sobre o problema e o resultado.]</p>
					)}
				</div>
				<div class="bento__meta">
					<p>
						<time datetime={String(e.ano)}>{e.ano}</time>, {e.onde}
					</p>
					<Seta direcao={e.externo ? "diagonal" : "direita"} />
				</div>
			</li>
		))}
	</ul>
</section>

<style>
	.bento {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--grade-espaco);
		padding: 0;
		list-style: none;
	}

	.bento__item {
		position: relative;
		display: grid;
		align-content: space-between;
		gap: var(--space-bloco);
		padding: var(--space-grande);
		border-radius: var(--bento-raio);
		background: var(--bento-fundo);
		transition: transform var(--motion-duration-pressionar) var(--motion-ease-out);
	}

	.bento__item:active {
		transform: scale(var(--bento-escala-pressionado));
	}

	.bento__imagem {
		display: grid;
		place-items: center;
		aspect-ratio: var(--destaque-proporcao);
		border-radius: var(--bento-imagem-raio);
		background: var(--bento-imagem-fundo);
	}

	.bento__texto {
		display: grid;
		gap: var(--space-medio);
	}

	/* Palavra comprida sem espaço quebra onde precisar, sem estourar o cartão. */
	.bento__titulo {
		overflow-wrap: anywhere;
		font-size: var(--text-entrada);
		letter-spacing: var(--tracking-entrada);
		line-height: var(--leading-titulo);
	}

	.bento__item[data-tamanho="pequeno"] .bento__titulo {
		font-size: var(--text-secao-case);
		letter-spacing: var(--tracking-secao-case);
	}

	.bento__link {
		color: var(--link-cor);
		text-decoration: none;
	}

	.bento__link::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.bento__link:focus-visible {
		outline: none;
	}

	.bento__link:focus-visible::before {
		outline: var(--focus-espessura) solid var(--focus-cor);
		outline-offset: var(--focus-afastamento);
		border-radius: var(--bento-raio);
	}

	.bento__descricao {
		max-inline-size: 40ch;
		color: var(--color-texto-secundario);
	}

	.bento__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-medio);
		color: var(--color-texto-secundario);
	}

	@media (hover: hover) and (pointer: fine) {
		.bento__item:hover :global(.seta__icone) {
			transform: translateX(var(--space-minimo));
		}
	}

	.bento__item:has(.bento__link:focus-visible) :global(.seta__icone) {
		transform: translateX(var(--space-minimo));
	}

	@media (min-width: 768px) {
		.bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.bento__item[data-tamanho="grande"] {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 1200px) {
		.bento {
			grid-template-columns: repeat(var(--grade-colunas), minmax(0, 1fr));
		}

		.bento__item[data-tamanho="grande"] {
			grid-column: 1 / span 7;
			grid-row: span 2;
		}

		.bento__item[data-tamanho="pequeno"] {
			grid-column: 8 / -1;
		}
	}
</style>
