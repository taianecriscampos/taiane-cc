---
/**
 * Projetos (rodada 1e): cartões de fundo cinza, raio de 24 px, sem borda e sem sombra.
 * Bento sem buraco:
 * - Celular: empilhados.
 * - 768 a 1199 px: o primeiro cartão (o que tem imagem) ocupa a largura toda, na horizontal,
 *   imagem à esquerda e texto à direita; embaixo, os outros dois lado a lado.
 * - 1200 px ou mais: três lado a lado, 4 colunas cada da grade de 12.
 * Os cartões de uma mesma linha têm a mesma altura: se um verso precisa de mais espaço,
 * a linha inteira cresce. Nada é cortado nem comprimido.
 *
 * Hierarquia única do site: título do cartão 32/40, chamada 16/24 secundária, "ano, empresa"
 * 16/24 secundário (como em Artigos).
 *
 * Dois tipos de cartão:
 * - Com página: imagem no topo; o título é o link, esticado para o cartão inteiro, com a seta.
 * - Que vira (case sem página nesta versão): cartão só tipográfico. Título e chamada no topo,
 *   "ano, empresa" e "Ver resumo" colados na base; o espaço livre no meio é respiro.
 *   O botão "Ver resumo", esticado para o cartão inteiro, gira o cartão no eixo Y e mostra o
 *   verso escuro. O lado escondido fica inerte. "Voltar", Esc ou um clique no verso desviram.
 *   Com movimento reduzido, o giro vira um esmaecimento de 150 ms.
 *
 * Ícone de "Ver resumo": seta curva aberta (Lucide redo-2, licença ISC), que diz "virar".
 * A opção da mão (Lucide pointer) fica disponível pela prop `icone`, para comparar no Laboratório.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { perfil } from "../../dados/perfil";
import LinkComSeta from "../ui/LinkComSeta.astro";
import Seta from "../ui/Seta.astro";
import type { Entrada } from "../ui/Entrada.astro";

export interface Projeto extends Entrada {
	/** Imagem do cartão (só nos cartões com página). */
	imagem?: { src: ImageMetadata; alt: string };
	/** Com verso, o cartão vira em vez de levar a uma página. */
	verso?: { subtitulo: string; blocos: { rotulo: string; texto: string }[] };
}

interface Props {
	projetos: Projeto[];
	/** Muda o id quando o bloco aparece mais de uma vez (Laboratório). */
	id?: string;
	rotulo?: string;
	/** Ícone de "Ver resumo": seta curva aberta (padrão) ou mão. */
	icone?: "seta" | "mao";
}

const { projetos, id = "projetos", rotulo = "Projetos", icone = "seta" } = Astro.props;
---

<section class="secao envoltorio" id={id} aria-labelledby={`${id}-titulo`}>
	<h2 id={`${id}-titulo`} class="secao__rotulo">
		{rotulo}
	</h2>
	<ul class="projetos" role="list">
		{projetos.map((p, i) => {
			const verso = p.verso;
			const versoId = `${id}-verso-${i}`;
			return (
				<li
					class="projeto"
					data-virar={verso ? "" : undefined}
					data-com-imagem={p.imagem ? "" : undefined}
				>
					<div class="projeto__giro">
						<div class="projeto__face projeto__frente" data-esmaecer>
							{p.imagem && (
								<div class="projeto__imagem">
									<Image
										src={p.imagem.src}
										alt={p.imagem.alt}
										widths={[400, 600, 800, 1200]}
										sizes="(min-width: 1200px) 30vw, (min-width: 768px) 45vw, 90vw"
									/>
								</div>
							)}
							<div class="projeto__texto">
								<h3 class="projeto__titulo">
									{verso ? (
										p.titulo
									) : (
										<a
											class="projeto__link"
											href={p.href}
											target={p.externo ? "_blank" : undefined}
											rel={p.externo ? "noopener noreferrer" : undefined}
										>
											{p.titulo}
											{p.externo && <span class="so-leitor-de-tela"> — abre em nova aba</span>}
										</a>
									)}
								</h3>
								{p.descricao && (
									<p class="projeto__chamada" data-rascunho={p.rascunho ? "" : undefined}>
										{p.descricao}
									</p>
								)}
							</div>
							<div class="projeto__meta">
								<p>
									<time datetime={String(p.ano)}>{p.ano}</time>, {p.onde}
								</p>
								{verso ? (
									<button
										class="projeto__virar"
										type="button"
										aria-expanded="false"
										aria-controls={versoId}
										data-virar-botao
									>
										Ver resumo<span class="so-leitor-de-tela"> de {p.titulo}</span>
										<svg
											class="projeto__icone"
											viewBox="0 0 24 24"
											width="20"
											height="20"
											aria-hidden="true"
											focusable="false"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											{icone === "mao" ? (
												<>
													<path d="M22 14a8 8 0 0 1-8 8" />
													<path d="M18 11v-1a2 2 0 0 0-2-2a2 2 0 0 0-2 2" />
													<path d="M14 10V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1" />
													<path d="M10 9.5V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v10" />
													<path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
												</>
											) : (
												<>
													<path d="m15 14 5-5-5-5" />
													<path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13" />
												</>
											)}
										</svg>
									</button>
								) : (
									<Seta direcao={p.externo ? "diagonal" : "direita"} />
								)}
							</div>
						</div>

						{verso && (
							<div
								class="projeto__face projeto__verso"
								id={versoId}
								role="group"
								aria-label={`Resumo de ${p.titulo}`}
								tabindex="-1"
								inert
								data-esmaecer
								data-verso
							>
								<div class="projeto__texto">
									<p class="projeto__titulo" aria-hidden="true">
										{p.titulo}
									</p>
									<p class="projeto__subtitulo">{verso.subtitulo}</p>
								</div>
								<dl class="projeto__blocos">
									{verso.blocos.map((bloco) => (
										<div>
											<dt class="projeto__rotulo">{bloco.rotulo}</dt>
											<dd>{bloco.texto}</dd>
										</div>
									))}
								</dl>
								<div class="projeto__verso-rodape">
									<p>
										Quer saber mais?{" "}
										<LinkComSeta href={perfil.linkedin} texto="Me chama no LinkedIn" externo />
									</p>
									<button class="projeto__voltar" type="button" data-voltar>
										Voltar
									</button>
								</div>
							</div>
						)}
					</div>
				</li>
			);
		})}
	</ul>
</section>

<script>
	for (const cartao of document.querySelectorAll<HTMLElement>("[data-virar]")) {
		const botao = cartao.querySelector<HTMLButtonElement>("[data-virar-botao]");
		const frente = cartao.querySelector<HTMLElement>(".projeto__frente");
		const verso = cartao.querySelector<HTMLElement>("[data-verso]");
		const voltar = cartao.querySelector<HTMLButtonElement>("[data-voltar]");
		if (!botao || !frente || !verso || !voltar) continue;

		const virar = (virado: boolean) => {
			cartao.toggleAttribute("data-virado", virado);
			botao.setAttribute("aria-expanded", String(virado));
			// Só o lado visível recebe foco e é lido; o outro fica inerte.
			frente.inert = virado;
			verso.inert = !virado;
			(virado ? verso : botao).focus({ preventScroll: true });
		};

		botao.addEventListener("click", () => virar(true));
		voltar.addEventListener("click", () => virar(false));
		// Clicar no verso (fora do link e do botão) desvira, como clicar de novo na carta.
		verso.addEventListener("click", (evento) => {
			if (!(evento.target as HTMLElement).closest("a, button")) virar(false);
		});
		verso.addEventListener("keydown", (evento) => {
			if (evento.key === "Escape") virar(false);
		});
	}
</script>

<style>
	.projetos {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--grade-espaco);
		padding: 0;
		list-style: none;
	}

	/* A perspectiva fica no pai: o giro tem profundidade sem distorcer. */
	.projeto {
		display: grid;
		perspective: var(--projeto-perspectiva);
		transition: transform var(--motion-duration-pressionar) var(--motion-ease-out);
	}

	.projeto:active {
		transform: scale(var(--projeto-escala-pressionado));
	}

	/* Frente e verso na mesma célula: o cartão tem a altura do lado mais alto. */
	.projeto__giro {
		position: relative;
		display: grid;
		transform-style: preserve-3d;
		transition: transform var(--motion-duration-virar) var(--motion-ease-out);
	}

	.projeto[data-virado] .projeto__giro {
		transform: rotateY(180deg);
	}

	.projeto__face {
		position: relative;
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		gap: var(--space-grande);
		padding: var(--projeto-espaco);
		border-radius: var(--projeto-raio);
		background: var(--projeto-fundo);
		-webkit-backface-visibility: hidden;
		backface-visibility: hidden;
	}

	/* O lado inerte não recebe clique, mesmo estando por cima. */
	.projeto__face[inert] {
		pointer-events: none;
	}

	.projeto__imagem {
		overflow: hidden;
		aspect-ratio: var(--destaque-proporcao);
		border-radius: var(--projeto-imagem-raio);
		background: var(--projeto-imagem-fundo);
	}

	.projeto__imagem img {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.projeto__texto {
		display: grid;
		gap: var(--space-pequeno);
	}

	/* Título de cartão: 32/40, peso 500, em todas as larguras. */
	.projeto__titulo {
		overflow-wrap: anywhere;
		font-size: var(--text-titulo-cartao);
		font-weight: var(--peso-titulo);
		letter-spacing: var(--tracking-titulo-cartao);
		line-height: var(--leading-titulo-cartao);
	}

	.projeto__link {
		color: var(--link-cor);
		text-decoration: none;
	}

	/* O link e o botão "Ver resumo" se esticam pelo cartão inteiro. */
	.projeto__link::before,
	.projeto__virar::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: var(--projeto-raio);
	}

	.projeto__link:focus-visible,
	.projeto__virar:focus-visible {
		outline: none;
	}

	.projeto__link:focus-visible::before,
	.projeto__virar:focus-visible::before {
		outline: var(--focus-espessura) solid var(--focus-cor);
		outline-offset: var(--focus-afastamento);
	}

	.projeto__chamada {
		max-inline-size: 40ch;
		color: var(--color-texto-secundario);
	}

	/* Colado na base do cartão. */
	.projeto__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-medio);
		margin-block-start: auto;
		color: var(--color-texto-secundario);
	}

	/* "Ver resumo": no lugar da seta, com a altura mínima de toque. */
	.projeto__virar {
		display: inline-flex;
		align-items: center;
		gap: var(--space-pequeno);
		min-block-size: var(--alvo-toque);
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-texto);
		cursor: pointer;
		user-select: none;
		-webkit-user-select: none;
	}

	.projeto__icone {
		inline-size: var(--seta-tamanho);
		block-size: var(--seta-tamanho);
		transition: transform var(--motion-duration-base) var(--motion-ease-out);
	}

	/* ---------- verso ---------- */
	.projeto__verso {
		background: var(--projeto-verso-fundo);
		color: var(--projeto-verso-texto);
		transform: rotateY(180deg);
		--link-cor: var(--projeto-verso-texto);
		--focus-cor: var(--projeto-verso-focus-cor);
	}

	/* O foco no verso inteiro (depois do giro) fica do lado de fora, na cor do texto da página. */
	.projeto__verso:focus-visible {
		outline-color: var(--color-texto);
	}

	.projeto__subtitulo,
	.projeto__rotulo {
		color: var(--projeto-verso-texto-secundario);
	}

	/* 24 px depois do subtítulo (o gap da face); 16 px entre os blocos. */
	.projeto__blocos {
		display: grid;
		gap: var(--space-medio);
	}

	.projeto__blocos dd {
		margin: 0;
	}

	/* Uma linha só: o convite à esquerda, "Voltar" à direita, colados na base.
	   Se o convite não couber, ele quebra dentro do próprio lado; "Voltar" fica na última linha. */
	.projeto__verso-rodape {
		display: flex;
		align-items: last baseline;
		justify-content: space-between;
		gap: var(--space-medio);
		margin-block-start: auto;
	}

	/* No verso, a seta fica colada ao texto (a área de toque segue com 40 px de altura),
	   para o convite e "Voltar" caberem na mesma linha. */
	.projeto__verso :global(.seta) {
		inline-size: var(--seta-tamanho);
		margin-inline-start: var(--space-minimo);
		color: inherit;
	}

	.projeto__voltar {
		flex: none;
		min-block-size: var(--alvo-toque);
		padding-inline: var(--space-pequeno);
		margin-inline-end: calc(-1 * var(--space-pequeno));
		border: 0;
		border-radius: var(--radius-medio);
		background: transparent;
		color: inherit;
		cursor: pointer;
		text-decoration: underline;
		text-decoration-thickness: var(--link-sublinhado);
		text-underline-offset: var(--link-sublinhado-afastamento);
		user-select: none;
		-webkit-user-select: none;
	}

	/* ---------- resposta ao ponteiro ---------- */
	@media (hover: hover) and (pointer: fine) {
		.projeto:hover :global(.seta__icone),
		.projeto:hover .projeto__icone {
			transform: translateX(var(--space-minimo));
		}
	}

	.projeto:has(.projeto__link:focus-visible) :global(.seta__icone),
	.projeto:has(.projeto__virar:focus-visible) .projeto__icone {
		transform: translateX(var(--space-minimo));
	}

	/* Movimento reduzido: sem giro; frente e verso trocam por esmaecimento curto. */
	@media (prefers-reduced-motion: reduce) {
		.projeto__giro,
		.projeto[data-virado] .projeto__giro,
		.projeto__verso {
			transform: none;
		}

		.projeto__face {
			transition: opacity var(--motion-duration-esmaecer) var(--motion-ease-out);
		}

		.projeto__verso,
		.projeto[data-virado] .projeto__frente {
			opacity: 0;
		}

		.projeto[data-virado] .projeto__verso {
			opacity: 1;
		}
	}

	/* Tablet: o cartão com imagem ocupa a linha toda, na horizontal; os outros, lado a lado. */
	@media (min-width: 768px) {
		.projetos {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.projeto__chamada {
			max-inline-size: none;
		}
	}

	@media (min-width: 768px) and (max-width: 1199px) {
		.projeto[data-com-imagem] {
			grid-column: 1 / -1;
		}

		.projeto[data-com-imagem] .projeto__frente {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: auto 1fr;
			column-gap: var(--grade-espaco);
		}

		.projeto[data-com-imagem] .projeto__imagem {
			grid-row: 1 / -1;
			align-self: start;
		}

		.projeto[data-com-imagem] .projeto__meta {
			align-self: end;
		}
	}

	@media (min-width: 1200px) {
		.projetos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
