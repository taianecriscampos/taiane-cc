---
/**
 * Topo do case, com a personalidade inspirada na kora.framer.media: título grande, em toda a
 * largura, com espaço entre letras apertado.
 * Abaixo, em duas colunas: à esquerda, a introdução em texto grande, peso 400 (resumo de até
 * 3 frases, ADR 0002); à direita, as disciplinas em pílulas e a ficha (empresa, ano, papel,
 * duração, tempo de leitura e, nos confidenciais, "Case sob sigilo").
 * Depois, a capa direto na página, sem moldura, com raio de 24 px.
 * Resultados e resumo (rodada 1e): sem cartões e sem fundo, em três colunas separadas por
 * linhas verticais de 1 px; no celular, empilhadas, com as linhas na horizontal.
 * Resultados: número em 56/56 (40 no celular), peso 500, e a descrição em 16/24.
 * Minha atuação, Desafio e Solução: rótulo 16/24 secundário e texto de destaque 20/28.
 * Conteúdo de exemplo: os campos listados em `rascunhos` ganham data-rascunho (docs/rascunhos.md).
 * Sem capa, uma ilustração neutra de exemplo. Sem duração conhecida, a ficha não mostra a linha.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Ilustracao from "../ui/Ilustracao.astro";

interface Props {
	titulo: string;
	resumo: string;
	empresa: string;
	ano: number;
	papel: string;
	duracao?: string;
	disciplinas: string[];
	/** Capa do case, no bloco de destaque. */
	imagem?: { src: ImageMetadata; alt: string };
	minutos: number;
	sigilo: "publico" | "confidencial";
	resultados: { valor: string; descricao: string }[];
	cartoes: { atuacao: string; desafio: string; solucao: string };
	/** Campos com conteúdo de exemplo. */
	rascunhos?: string[];
	nivel?: 1 | 2;
}

const {
	titulo,
	resumo,
	empresa,
	ano,
	papel,
	duracao,
	disciplinas,
	imagem,
	minutos,
	sigilo,
	resultados,
	cartoes,
	rascunhos = [],
	nivel = 1,
} = Astro.props;
const Titulo = `h${nivel}` as const;
/** data-rascunho no elemento quando o campo ainda é conteúdo de exemplo. */
const rascunho = (campo: string) => (rascunhos.includes(campo) ? "" : undefined);

const ficha = [
	{ rotulo: "Empresa", valor: empresa },
	{ rotulo: "Ano", valor: String(ano) },
	{ rotulo: "Papel", valor: papel },
	{ rotulo: "Duração", valor: duracao, campo: "duracao" },
	{ rotulo: "Leitura", valor: `${minutos} ${minutos === 1 ? "minuto" : "minutos"} de leitura` },
].filter((item): item is { rotulo: string; valor: string; campo?: string } => !!item.valor);

const listaDeCartoes = [
	{ rotulo: "Minha atuação", texto: cartoes.atuacao },
	{ rotulo: "Desafio", texto: cartoes.desafio },
	{ rotulo: "Solução", texto: cartoes.solucao },
];
---

<header class="cabecalho-case">
	<Titulo class="cabecalho-case__titulo">{titulo}</Titulo>

	<div class="cabecalho-case__intro">
		<p class="cabecalho-case__resumo" data-rascunho={rascunho("resumo")}>
			{resumo}
		</p>

		<div class="cabecalho-case__lado">
			{disciplinas.length > 0 && (
				<ul
					class="cabecalho-case__pilulas"
					role="list"
					aria-label="Disciplinas"
					data-rascunho={rascunho("disciplinas")}
				>
					{disciplinas.map((d) => (
						<li class="cabecalho-case__pilula">{d}</li>
					))}
				</ul>
			)}

			<dl class="cabecalho-case__ficha">
				{ficha.map((item) => (
					<div class="cabecalho-case__ficha-linha">
						<dt>{item.rotulo}</dt>
						<dd data-rascunho={item.campo ? rascunho(item.campo) : undefined}>
							{item.rotulo === "Ano" ? <time datetime={item.valor}>{item.valor}</time> : item.valor}
						</dd>
					</div>
				))}
			</dl>
			{sigilo === "confidencial" && <p class="cabecalho-case__sigilo">Case sob sigilo</p>}
		</div>
	</div>

	<div class="cabecalho-case__destaque">
		<div class="cabecalho-case__imagem">
			{imagem ? (
				<Image
					src={imagem.src}
					alt={imagem.alt}
					widths={[480, 800, 1200, 1600]}
					sizes="(min-width: 1440px) 1360px, 95vw"
					loading="eager"
				/>
			) : (
				<Ilustracao variante={1} />
			)}
		</div>
		<ul
			class="cabecalho-case__resultados"
			role="list"
			aria-label="Resultados"
			data-rascunho={rascunho("resultados")}
		>
			{resultados.map((r) => (
				<li class="cabecalho-case__resultado">
					<p class="cabecalho-case__valor">{r.valor}</p>
					<p>{r.descricao}</p>
				</li>
			))}
		</ul>
	</div>

	<ul class="cabecalho-case__cartoes" role="list" data-rascunho={rascunho("cartoes")}>
		{listaDeCartoes.map((cartao) => (
			<li class="cabecalho-case__cartao">
				<p class="cabecalho-case__rotulo">{cartao.rotulo}</p>
				<p class="cabecalho-case__texto">{cartao.texto}</p>
			</li>
		))}
	</ul>
</header>

<style>
	.cabecalho-case {
		display: grid;
		gap: var(--space-largo);
	}

	.cabecalho-case__titulo {
		font-size: var(--text-titulo-case);
		letter-spacing: var(--tracking-titulo-case);
		line-height: var(--leading-titulo);
		text-wrap: balance;
	}

	.cabecalho-case__intro {
		display: grid;
		gap: var(--space-bloco);
	}

	.cabecalho-case__resumo {
		font-size: var(--text-introducao);
		font-weight: var(--peso-corpo);
		letter-spacing: var(--tracking-introducao);
		line-height: var(--leading-introducao);
	}

	.cabecalho-case__lado {
		display: grid;
		align-content: start;
		gap: var(--space-grande);
	}

	.cabecalho-case__pilulas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-pequeno);
		padding: 0;
		list-style: none;
	}

	.cabecalho-case__pilula {
		padding: var(--pilula-espaco);
		border-radius: var(--radius-pilula);
		background: var(--pilula-fundo);
		font-size: var(--text-pequeno);
		line-height: var(--leading-pequeno);
	}

	.cabecalho-case__ficha {
		display: grid;
		gap: var(--space-pequeno);
		font-size: var(--text-pequeno);
		line-height: var(--leading-pequeno);
	}

	.cabecalho-case__ficha-linha {
		display: grid;
		grid-template-columns: var(--ficha-rotulo-largura) minmax(0, 1fr);
		gap: var(--space-medio);
		padding-block-start: var(--space-pequeno);
		border-block-start: var(--divisoria);
	}

	.cabecalho-case__ficha dt,
	.cabecalho-case__sigilo {
		color: var(--color-texto-secundario);
	}

	.cabecalho-case__ficha dd {
		margin: 0;
	}

	.cabecalho-case__sigilo {
		font-size: var(--text-pequeno);
		line-height: var(--leading-pequeno);
	}

	/* ---------- capa e resultados ---------- */
	.cabecalho-case__destaque {
		display: grid;
		gap: var(--space-largo);
	}

	/* A capa direto na página: sem moldura nem fundo, só o raio. */
	.cabecalho-case__imagem {
		overflow: hidden;
		border-radius: var(--capa-raio);
	}

	.cabecalho-case__imagem img {
		display: block;
		inline-size: 100%;
		block-size: auto;
	}

	/* Três colunas com linhas verticais (celular: empilhadas, com linhas horizontais). */
	.cabecalho-case__resultados,
	.cabecalho-case__cartoes {
		display: grid;
		padding: 0;
		list-style: none;
	}

	.cabecalho-case__resultado,
	.cabecalho-case__cartao {
		display: grid;
		align-content: start;
		padding-block: var(--space-grande);
	}

	.cabecalho-case__resultado {
		gap: var(--space-medio);
	}

	.cabecalho-case__cartao {
		gap: var(--space-pequeno);
	}

	.cabecalho-case__resultado:first-child,
	.cabecalho-case__cartao:first-child {
		padding-block-start: 0;
	}

	.cabecalho-case__resultado:last-child,
	.cabecalho-case__cartao:last-child {
		padding-block-end: 0;
	}

	.cabecalho-case__resultado + .cabecalho-case__resultado,
	.cabecalho-case__cartao + .cabecalho-case__cartao {
		border-block-start: var(--divisoria);
	}

	/* Número: título de entrada (56/56, 40 no celular), peso 500. Um valor longo quebra a linha. */
	.cabecalho-case__valor {
		overflow-wrap: anywhere;
		font-size: var(--text-entrada);
		font-weight: var(--peso-titulo);
		letter-spacing: var(--tracking-entrada);
		line-height: var(--leading-titulo);
	}

	/* Rótulo 16/24 secundário; texto de destaque 20/28. */
	.cabecalho-case__rotulo {
		color: var(--color-texto-secundario);
	}

	.cabecalho-case__texto {
		font-size: var(--text-destaque);
		letter-spacing: var(--tracking-destaque);
		line-height: var(--leading-destaque);
	}

	@media (min-width: 768px) {
		.cabecalho-case__resultados,
		.cabecalho-case__cartoes {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.cabecalho-case__resultado,
		.cabecalho-case__cartao {
			padding-block: 0;
			padding-inline: var(--grade-espaco);
		}

		.cabecalho-case__resultado:first-child,
		.cabecalho-case__cartao:first-child {
			padding-inline-start: 0;
		}

		.cabecalho-case__resultado:last-child,
		.cabecalho-case__cartao:last-child {
			padding-inline-end: 0;
		}

		.cabecalho-case__resultado + .cabecalho-case__resultado,
		.cabecalho-case__cartao + .cabecalho-case__cartao {
			border-block-start: 0;
			border-inline-start: var(--divisoria);
		}
	}

	@media (min-width: 1200px) {
		.cabecalho-case__intro {
			grid-template-columns: repeat(var(--grade-colunas), minmax(0, 1fr));
			column-gap: var(--grade-espaco);
		}

		.cabecalho-case__resumo {
			grid-column: 1 / span 7;
		}

		.cabecalho-case__lado {
			grid-column: 9 / -1;
		}
	}
</style>
