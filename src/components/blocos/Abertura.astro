---
/**
 * Abertura: ocupa a altura da tela menos o cabeçalho, com topo e base afastados.
 * Topo: a frase como título e o retrato com o selo próprio sobre o canto inferior esquerdo.
 * Base: seta para Projetos e "Me encontre no LinkedIn".
 */
import { Image } from "astro:assets";
import retrato from "../../assets/taiane-retrato.png";
import { perfil as perfilPadrao, type Perfil } from "../../dados/perfil";
import LinkComSeta from "../ui/LinkComSeta.astro";
import Selo from "../ui/Selo.astro";
import Seta from "../ui/Seta.astro";

interface Props {
	perfil?: Perfil;
	/** Muda os ids quando a abertura aparece mais de uma vez (Laboratório). */
	idBase?: string;
	nivel?: 1 | 2;
}

const { perfil = perfilPadrao, idBase = "abertura", nivel = 1 } = Astro.props;
const Titulo = `h${nivel}` as const;
---

<section class="abertura envoltorio" aria-labelledby={`${idBase}-titulo`}>
	<div class="abertura__topo">
		<Titulo id={`${idBase}-titulo`} class="abertura__frase">
			{perfil.frase}
		</Titulo>
		<div class="abertura__retrato">
			<Image
				src={retrato}
				alt={`Retrato de ${perfil.nome}: cabelo escuro na altura dos ombros, com mechas grisalhas, e óculos de armação redonda e fina, sobre fundo claro.`}
				widths={[207, 414]}
				sizes="207px"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="abertura__selo">
				<Selo id={`${idBase}-selo`} />
			</div>
		</div>
	</div>

	<div class="abertura__base">
		<a class="abertura__descer" href="#projetos">
			<Seta direcao="baixo" tamanho="grande" />
			<span class="so-leitor-de-tela">Ir para Projetos</span>
		</a>
		<LinkComSeta href={perfil.linkedin} texto="Me encontre no LinkedIn" />
	</div>
</section>

<style>
	.abertura {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-bloco);
		min-block-size: calc(100svh - var(--cabecalho-altura));
		padding-block: var(--space-bloco) var(--space-grande);
	}

	.abertura__topo {
		display: grid;
		gap: var(--space-bloco);
	}

	.abertura__frase {
		font-size: var(--text-abertura);
		line-height: var(--leading-titulo);
	}

	/* No celular, o retrato recua 32 px para o selo não sair da tela. */
	.abertura__retrato {
		position: relative;
		justify-self: start;
		margin-inline-start: var(--space-maior);
	}

	.abertura__retrato img {
		inline-size: var(--retrato-largura);
		block-size: var(--retrato-altura);
		object-fit: cover;
		object-position: 50% 30%;
		border-radius: var(--retrato-raio);
	}

	.abertura__selo {
		position: absolute;
		inset-inline-start: var(--selo-deslocamento);
		inset-block-end: var(--selo-deslocamento);
	}

	.abertura__base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-medio);
	}

	.abertura__descer {
		border-radius: var(--radius-pilula);
	}

	@media (hover: hover) {
		.abertura__descer:hover :global(.seta__icone) {
			transform: translateY(var(--space-fio));
		}
	}

	@media (min-width: 768px) {
		.abertura__topo {
			grid-template-columns: repeat(var(--grade-colunas), minmax(0, 1fr));
			column-gap: var(--grade-espaco);
			align-items: start;
		}

		.abertura__frase {
			grid-column: 1 / span 8;
		}

		.abertura__retrato {
			grid-column: 9 / -1;
			justify-self: end;
			margin-inline-start: 0;
		}
	}
</style>
