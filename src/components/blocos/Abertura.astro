---
/**
 * Abertura: ocupa a altura da tela menos o cabeçalho.
 * No meio, centralizados na vertical: a frase em caixa alta e condensada (eixo de largura da
 * Google Sans Flex) e o retrato grande, de cantos arredondados.
 * Faixa de baixo: a especialidade com seta para baixo (leva a Projetos) e o LinkedIn com seta
 * diagonal. No celular, o modelo de trabalho com o ponto verde também fica nesta faixa.
 * A caixa alta vem do CSS: no HTML o texto continua normal, e o leitor de tela lê a frase certa.
 */
import { Image } from "astro:assets";
import retrato from "../../assets/taiane-retrato.png";
import { perfil as perfilPadrao, type Perfil } from "../../dados/perfil";
import Disponibilidade from "../ui/Disponibilidade.astro";
import LinkComSeta from "../ui/LinkComSeta.astro";

interface Props {
	perfil?: Perfil;
	/** Muda os ids quando a abertura aparece mais de uma vez (Laboratório). */
	idBase?: string;
	nivel?: 1 | 2;
}

const { perfil = perfilPadrao, idBase = "inicio", nivel = 1 } = Astro.props;
const Titulo = `h${nivel}` as const;
---

<section class="abertura envoltorio" id={idBase} aria-labelledby={`${idBase}-titulo`}>
	<div class="abertura__meio">
		<Titulo id={`${idBase}-titulo`} class="abertura__frase">
			{perfil.frase}
		</Titulo>
		<Image
			class="abertura__retrato"
			src={retrato}
			alt={`Retrato de ${perfil.nome}: cabelo escuro na altura dos ombros, com mechas grisalhas, e óculos de armação redonda e fina, sobre fundo claro.`}
			widths={[320, 480, 640, 960]}
			sizes="(min-width: 1200px) 30vw, (min-width: 768px) 38vw, 70vw"
			loading="eager"
			fetchpriority="high"
		/>
	</div>

	<div class="abertura__faixa">
		<LinkComSeta
			href="#projetos"
			texto={perfil.especialidade}
			direcao="baixo"
			complemento="ir para Projetos"
		/>
		<div class="abertura__status">
			<Disponibilidade texto={perfil.modalidade} />
		</div>
		<LinkComSeta href={perfil.linkedin} texto="Me encontre no LinkedIn" />
	</div>
</section>

<style>
	.abertura {
		display: flex;
		flex-direction: column;
		gap: var(--space-bloco);
		min-block-size: calc(100svh - var(--cabecalho-altura));
		padding-block: var(--space-grande);
	}

	.abertura__meio {
		flex: 1;
		display: grid;
		align-content: center;
		gap: var(--space-bloco);
	}

	.abertura__frase {
		font-size: var(--text-abertura);
		font-stretch: var(--fonte-largura-condensada);
		letter-spacing: var(--tracking-abertura);
		line-height: var(--leading-titulo);
		text-transform: uppercase;
	}

	.abertura__retrato {
		inline-size: min(100%, 70vw);
		aspect-ratio: var(--retrato-proporcao);
		object-fit: cover;
		object-position: 50% 30%;
		border-radius: var(--retrato-raio);
	}

	/* No celular, a faixa usa o texto pequeno para a especialidade caber numa linha com a seta. */
	.abertura__faixa {
		font-size: var(--text-pequeno);
		line-height: var(--leading-pequeno);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-pequeno) var(--space-medio);
	}

	.abertura__status {
		flex-basis: 100%;
		order: -1;
	}

	@media (hover: hover) and (pointer: fine) {
		.abertura__faixa :global(a[href="#projetos"]:hover .seta__icone) {
			transform: translateY(var(--space-fio));
		}
	}

	@media (min-width: 768px) {
		.abertura__meio {
			grid-template-columns: repeat(var(--grade-colunas), minmax(0, 1fr));
			column-gap: var(--grade-espaco);
			align-items: center;
		}

		.abertura__frase {
			grid-column: 1 / span 7;
		}

		.abertura__retrato {
			grid-column: 8 / -1;
			inline-size: 100%;
		}

		.abertura__faixa {
			font-size: var(--text-corpo);
			line-height: var(--leading-corpo);
		}

		.abertura__status {
			display: none;
		}
	}

	@media (min-width: 1200px) {
		.abertura__frase {
			grid-column: 1 / span 8;
		}

		.abertura__retrato {
			grid-column: 9 / -1;
		}
	}
</style>
