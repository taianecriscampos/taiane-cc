---
/**
 * Sobre: texto curto e currículo, Experiência e Educação, em 6, 3 e 3 colunas a partir de 1200 px.
 * Texto em RASCUNHO, a partir de docs/curriculo.md, para a Taiane reescrever com as palavras dela.
 */
import { perfil } from "../../dados/perfil";
import { experiencias, formacao } from "../../dados/trajetoria";
import LinkComSeta from "../ui/LinkComSeta.astro";

// Só as quatro experiências mais recentes; o histórico completo fica no currículo em PDF.
const experienciasRecentes = experiencias.slice(0, 4);
---

<section class="secao envoltorio" id="sobre" aria-labelledby="sobre-titulo">
	<h2 id="sobre-titulo" class="secao__rotulo">
		Sobre
	</h2>

	<div class="sobre">
		<div class="sobre__texto">
			<div class="rascunho">
				<p class="marcador">[RASCUNHO]</p>
				<p>
					Sou designer de produto há mais de 10 anos, na ponte entre estratégia de negócio,
					experiência do usuário e engenharia. Hoje atuo como Design Engineer: uso front-end e IA
					generativa para encurtar o caminho entre hipótese, protótipo e código funcional.
				</p>
			</div>
			{perfil.curriculo.disponivel ? (
				<LinkComSeta href={perfil.curriculo.href} texto="Acessar currículo em PDF" />
			) : (
				<p class="sobre__secundario">Currículo em PDF, em breve</p>
			)}
		</div>

		<div class="sobre__grupo">
			<h3 class="sobre__grupo-titulo">Experiência</h3>
			<ol class="sobre__lista" role="list">
				{experienciasRecentes.map((item) => (
					<li>
						<p class="sobre__forte">{item.empresa ?? item.cargo}</p>
						{item.empresa && <p>{item.cargo}</p>}
						<p class="sobre__secundario">
							<time datetime={String(item.inicio)}>{item.inicio}</time>
							<span aria-hidden="true">–</span>
							<span class="so-leitor-de-tela">até</span>
							<time datetime={String(item.fim)}>{item.fim}</time>
						</p>
					</li>
				))}
			</ol>
		</div>

		<div class="sobre__grupo">
			<h3 class="sobre__grupo-titulo">Educação</h3>
			<ol class="sobre__lista" role="list">
				{formacao.map((item) => (
					<li>
						<p class="sobre__forte">{item.instituicao}</p>
						<p>{item.curso}</p>
						<p class="sobre__secundario">
							{item.periodo}
							{item.situacao && `, ${item.situacao.toLowerCase()}`}
						</p>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<style>
	.sobre {
		display: grid;
		gap: var(--space-bloco);
	}

	.sobre__texto {
		display: grid;
		align-content: start;
		justify-items: start;
		gap: var(--space-grande);
	}

	.sobre__grupo {
		display: grid;
		align-content: start;
		gap: var(--space-pequeno);
	}

	.sobre__grupo-titulo {
		font-weight: var(--peso-corpo);
		line-height: var(--leading-corpo);
		color: var(--color-texto-secundario);
	}

	.sobre__lista {
		display: grid;
		gap: var(--space-pequeno);
		padding: 0;
		list-style: none;
	}

	.sobre__forte {
		font-weight: var(--peso-forte);
	}

	.sobre__secundario {
		color: var(--color-texto-secundario);
	}

	@media (min-width: 768px) {
		.sobre {
			grid-template-columns: repeat(var(--grade-colunas), minmax(0, 1fr));
			gap: var(--space-bloco) var(--grade-espaco);
		}

		.sobre__texto {
			grid-column: 1 / -1;
		}

		.sobre__grupo {
			grid-column: span 6;
		}
	}

	@media (min-width: 1200px) {
		.sobre__texto {
			grid-column: 1 / span 6;
		}

		.sobre__grupo {
			grid-column: span 3;
		}
	}
</style>
