---
/**
 * Sobre: três colunas de mesma largura a partir de 768 px, com títulos no mesmo estilo:
 * Resumo, Experiência profissional e Formação acadêmica. Curso não concluído: a mesma estrutura
 * dos outros, com uma etiqueta discreta "não concluída" ao lado do ano.
 * Abaixo das colunas, uma linha: "Currículo em PDF" numa ponta e "Mais informações no LinkedIn"
 * na outra, os dois em nova aba.
 * Texto em RASCUNHO, a partir de docs/curriculo.md, para a Taiane reescrever com as palavras dela.
 */
import { perfil } from "../../dados/perfil";
import { experienciasDoSobre, formacaoDoSobre } from "../../dados/trajetoria";
import LinkComSeta from "../ui/LinkComSeta.astro";

/** "2025–2026" vira duas datas, e o leitor de tela lê "2025 até 2026". */
const partes = (periodo: string) => periodo.split("–");
---

<section class="secao envoltorio" id="sobre" aria-labelledby="sobre-titulo">
	<h2 id="sobre-titulo" class="secao__rotulo">
		Sobre
	</h2>

	<div class="sobre">
		<div class="sobre__coluna">
			<h3 class="sobre__grupo-titulo">Resumo</h3>
			<div class="rascunho">
				<p class="marcador">[RASCUNHO]</p>
				<p>
					Sou designer de produto há mais de 10 anos, na ponte entre estratégia de negócio,
					experiência do usuário e engenharia. Hoje atuo como Design Engineer: uso front-end e IA
					generativa para encurtar o caminho entre hipótese, protótipo e código funcional.
				</p>
			</div>
		</div>

		<div class="sobre__coluna">
			<h3 class="sobre__grupo-titulo">Experiência profissional</h3>
			<ol class="sobre__lista" role="list">
				{experienciasDoSobre.map((item) => (
					<li>
						<p class="sobre__forte">{item.empresa}</p>
						<p>{item.cargo}</p>
						<p class="sobre__secundario">
							{partes(item.periodo).map((ano, i) => (
								<>
									{i > 0 && (
										<>
											<span aria-hidden="true">–</span>
											<span class="so-leitor-de-tela">até</span>
										</>
									)}
									<time datetime={ano}>{ano}</time>
								</>
							))}
						</p>
					</li>
				))}
			</ol>
		</div>

		<div class="sobre__coluna">
			<h3 class="sobre__grupo-titulo">Formação acadêmica</h3>
			<ol class="sobre__lista" role="list">
				{formacaoDoSobre.map((item) => (
					<li>
						<p class="sobre__forte">{item.instituicao}</p>
						<p>{item.curso}</p>
						<p class="sobre__secundario sobre__ano">
							{item.periodo}
							{!item.concluida && <span class="sobre__etiqueta">não concluída</span>}
						</p>
					</li>
				))}
			</ol>
		</div>
	</div>

	<div class="sobre__links">
		{perfil.curriculo.disponivel ? (
			<LinkComSeta href={perfil.curriculo.href} texto="Currículo em PDF" externo />
		) : (
			<p class="sobre__secundario">Currículo em PDF, em breve</p>
		)}
		<LinkComSeta href={perfil.linkedin} texto="Mais informações no LinkedIn" externo />
	</div>
</section>

<style>
	.sobre {
		display: grid;
		gap: var(--space-bloco);
	}

	.sobre__coluna {
		display: grid;
		align-content: start;
		justify-items: start;
		gap: var(--space-grande);
	}

	.sobre__grupo-titulo {
		font-weight: var(--peso-corpo);
		line-height: var(--leading-corpo);
		color: var(--color-texto-secundario);
	}

	.sobre__lista {
		display: grid;
		gap: var(--space-medio);
		padding: 0;
		list-style: none;
	}

	.sobre__forte {
		font-weight: var(--peso-forte);
	}

	.sobre__secundario {
		color: var(--color-texto-secundario);
	}

	.sobre__ano {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-pequeno);
	}

	/* Etiqueta discreta: pílula pequena, cinza claro, texto secundário. */
	.sobre__etiqueta {
		padding: var(--etiqueta-espaco);
		border-radius: var(--radius-pilula);
		background: var(--etiqueta-fundo);
		color: var(--etiqueta-texto);
		font-size: var(--etiqueta-tamanho);
		line-height: var(--leading-legenda);
	}

	.sobre__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-pequeno) var(--space-medio);
	}

	@media (min-width: 768px) {
		.sobre {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: var(--grade-espaco);
		}
	}
</style>
