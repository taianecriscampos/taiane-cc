---
/**
 * Sobre: três colunas a partir de 768 px, com títulos no mesmo estilo: Resumo, Experiência
 * profissional e Formação acadêmica. As colunas vêm de ColunasSobre (largura do conteúdo, mesmo
 * espaço entre elas), compartilhadas com Skills. Curso não concluído: a mesma estrutura
 * dos outros, com uma etiqueta discreta "não concluída" ao lado do ano.
 * Abaixo das colunas, uma linha: "Currículo em PDF" numa ponta e "Mais informações no LinkedIn"
 * na outra, os dois em nova aba.
 * O resumo é conteúdo de exemplo (data-rascunho), a partir de docs/curriculo.md, para a Taiane
 * reescrever com as palavras dela.
 */
import { perfil } from "../../dados/perfil";
import { experienciasDoSobre, formacaoDoSobre } from "../../dados/trajetoria";
import LinkComSeta from "../ui/LinkComSeta.astro";

/** "2025–2026" vira duas datas, e o leitor de tela lê "2025 até 2026". */
const partes = (periodo: string) => periodo.split("–");
---

<section class="secao sobre-secao" id="sobre" aria-labelledby="sobre-titulo">
	<h2 id="sobre-titulo" class="secao__rotulo">
		Sobre
	</h2>

	<div class="sobre">
		<div class="sobre__coluna">
			<h3 class="sobre__grupo-titulo">Resumo</h3>
			<p data-rascunho>
				Sou designer de produto há mais de 10 anos, na ponte entre estratégia de negócio,
				experiência do usuário e engenharia. Comecei na direção de arte, passei por sistemas
				regulatórios e plataformas SaaS e estruturei design systems em escala corporativa.
			</p>
			<p data-rascunho>
				Hoje atuo como Design Engineer: uso front-end e IA generativa para encurtar o caminho entre
				hipótese, protótipo e código funcional.
			</p>
		</div>

		<div class="sobre__coluna">
			<h3 class="sobre__grupo-titulo">Experiência profissional</h3>
			<ol class="sobre__lista" role="list">
				{experienciasDoSobre.map((item) => (
					<li>
						<p class="sobre__forte">{item.empresa}</p>
						<p>{item.cargo}</p>
						<p class="sobre__secundario">
							{partes(item.periodo).map((ano, i) => (
								<>
									{i > 0 && (
										<>
											<span aria-hidden="true">–</span>
											<span class="so-leitor-de-tela">até</span>
										</>
									)}
									<time datetime={ano}>{ano}</time>
								</>
							))}
						</p>
					</li>
				))}
			</ol>
		</div>

		<div class="sobre__coluna">
			<h3 class="sobre__grupo-titulo">Formação acadêmica</h3>
			<ol class="sobre__lista" role="list">
				{formacaoDoSobre.map((item) => (
					<li>
						<p class="sobre__forte">{item.instituicao}</p>
						<p>{item.curso}</p>
						<p class="sobre__secundario sobre__ano">
							{item.periodo}
							{!item.concluida && <span class="sobre__etiqueta">não concluída</span>}
						</p>
					</li>
				))}
			</ol>
		</div>
	</div>

	<div class="sobre__links">
		{perfil.curriculo.disponivel ? (
			<LinkComSeta href={perfil.curriculo.href} texto="Currículo em PDF" externo />
		) : (
			<p class="sobre__secundario">Currículo em PDF, em breve</p>
		)}
		<LinkComSeta href={perfil.linkedin} texto="Mais informações no LinkedIn" externo />
	</div>
</section>

<style>
	.sobre {
		display: grid;
		gap: var(--space-bloco);
	}

	.sobre__coluna {
		display: grid;
		align-content: start;
		justify-items: start;
		gap: var(--space-grande);
	}

	.sobre__grupo-titulo {
		font-weight: var(--peso-corpo);
		line-height: var(--leading-corpo);
		color: var(--color-texto-secundario);
	}

	.sobre__lista {
		display: grid;
		gap: var(--space-medio);
		padding: 0;
		list-style: none;
	}

	.sobre__forte {
		font-weight: var(--peso-forte);
	}

	.sobre__secundario {
		color: var(--color-texto-secundario);
	}

	.sobre__ano {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-pequeno);
	}

	/* Etiqueta discreta: pílula pequena, cinza claro, texto secundário. */
	.sobre__etiqueta {
		padding: var(--etiqueta-espaco);
		border-radius: var(--radius-pilula);
		background: var(--etiqueta-fundo);
		color: var(--etiqueta-texto);
		font-size: var(--etiqueta-tamanho);
		line-height: var(--leading-legenda);
	}

	.sobre__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-pequeno) var(--space-medio);
	}

	/* Herda as três trilhas de ColunasSobre: título e links ocupam todas; as colunas, uma cada. */
	@media (min-width: 768px) {
		.sobre-secao,
		.sobre {
			grid-column: 1 / -1;
			grid-template-columns: subgrid;
			/* normal: herda o espaço do contêiner. Um valor próprio faria as colunas engordarem. */
			column-gap: normal;
		}

		.sobre-secao > * {
			grid-column: 1 / -1;
		}

		/* Rótulo e linha dos links ocupam as três colunas sem mexer na largura delas. */
		.sobre-secao > :not(.sobre) {
			contain: inline-size;
		}

		/* Tablet: a primeira coluna ocupa a linha de cima inteira, com a linha de leitura curta. */
		.sobre__coluna:first-child {
			grid-column: 1 / -1;
			max-inline-size: var(--sobre-coluna-texto);
		}
	}

	@media (min-width: 1200px) {
		.sobre__coluna:first-child {
			grid-column: auto;
			max-inline-size: none;
		}
	}
</style>
