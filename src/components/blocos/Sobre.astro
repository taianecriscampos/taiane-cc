---
/**
 * Sobre (rodada 1e): três colunas a partir de 768 px, Resumo, Experiência profissional e
 * Formação acadêmica, com títulos em rótulo (16/24, cor secundária).
 * Grade 1fr auto 1fr: Resumo e Formação com a mesma largura; a Experiência fica do tamanho do
 * próprio conteúdo; os dois vãos entre as colunas são iguais (o mesmo column-gap).
 * Segunda linha da grade: "Currículo em PDF" logo abaixo do Resumo e "Mais informações no
 * LinkedIn" na coluna da Formação, na mesma linha de base. A Experiência ocupa as duas linhas.
 * Curso não concluído: a mesma estrutura dos outros, com a etiqueta "não concluída" (14/20, 500).
 * O Resumo é o texto de antes da rodada 1d, a pedido da Taiane.
 */
import { perfil } from "../../dados/perfil";
import { experienciasDoSobre, formacaoDoSobre } from "../../dados/trajetoria";
import LinkComSeta from "../ui/LinkComSeta.astro";

/** "2025–2026" vira duas datas, e o leitor de tela lê "2025 até 2026". */
const partes = (periodo: string) => periodo.split("–");
---

<section class="secao envoltorio" id="sobre" aria-labelledby="sobre-titulo">
	<h2 id="sobre-titulo" class="secao__rotulo">
		Sobre
	</h2>

	<div class="sobre">
		<div class="sobre__coluna">
			<h3 class="sobre__grupo-titulo">Resumo</h3>
			<div class="sobre__resumo">
				<p>
					Sou designer de produto há mais de 10 anos, na ponte entre estratégia de negócio,
					experiência do usuário e engenharia. Comecei na direção de arte, passei por sistemas
					regulatórios e plataformas SaaS e estruturei design systems em escala corporativa.
				</p>
				<p>
					Hoje atuo como Design Engineer: uso front-end e IA generativa para encurtar o caminho
					entre hipótese, protótipo e código funcional.
				</p>
			</div>
		</div>

		<div class="sobre__link sobre__link--curriculo">
			{perfil.curriculo.disponivel ? (
				<LinkComSeta href={perfil.curriculo.href} texto="Currículo em PDF" externo />
			) : (
				<p class="sobre__secundario">Currículo em PDF, em breve</p>
			)}
		</div>

		<div class="sobre__coluna sobre__coluna--experiencia">
			<h3 class="sobre__grupo-titulo">Experiência profissional</h3>
			<ol class="sobre__lista" role="list">
				{experienciasDoSobre.map((item) => (
					<li>
						<p class="sobre__forte">{item.empresa}</p>
						<p>{item.cargo}</p>
						<p class="sobre__secundario">
							{partes(item.periodo).map((ano, i) => (
								<>
									{i > 0 && (
										<>
											<span aria-hidden="true">–</span>
											<span class="so-leitor-de-tela">até</span>
										</>
									)}
									<time datetime={ano}>{ano}</time>
								</>
							))}
						</p>
					</li>
				))}
			</ol>
		</div>

		<div class="sobre__coluna sobre__coluna--formacao">
			<h3 class="sobre__grupo-titulo">Formação acadêmica</h3>
			<ol class="sobre__lista" role="list">
				{formacaoDoSobre.map((item) => (
					<li>
						<p class="sobre__forte">{item.instituicao}</p>
						<p>{item.curso}</p>
						<p class="sobre__secundario sobre__ano">
							{item.periodo}
							{!item.concluida && <span class="sobre__etiqueta">não concluída</span>}
						</p>
					</li>
				))}
			</ol>
		</div>

		<div class="sobre__link sobre__link--linkedin">
			<LinkComSeta href={perfil.linkedin} texto="Mais informações no LinkedIn" externo />
		</div>
	</div>
</section>

<style>
	/* Celular: uma coluna, na ordem do HTML: Resumo, Currículo, Experiência, Formação, LinkedIn. */
	.sobre {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-bloco);
	}

	.sobre__coluna {
		display: grid;
		align-content: start;
		justify-items: start;
		gap: var(--space-grande);
	}

	/* Rótulo: 16/24, cor secundária. */
	.sobre__grupo-titulo {
		font-weight: var(--peso-corpo);
		line-height: var(--leading-corpo);
		color: var(--color-texto-secundario);
	}

	.sobre__resumo {
		display: grid;
		gap: var(--space-medio);
	}

	/* O link do Currículo fica logo abaixo do texto do Resumo. */
	.sobre__link--curriculo {
		margin-block-start: calc(var(--space-grande) - var(--space-bloco));
	}

	.sobre__lista {
		display: grid;
		gap: var(--space-medio);
		padding: 0;
		list-style: none;
	}

	.sobre__forte {
		font-weight: var(--peso-forte);
	}

	.sobre__secundario {
		color: var(--color-texto-secundario);
	}

	.sobre__ano {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-pequeno);
	}

	/* Etiqueta: pequeno (14/20), peso 500, mesma cor e fundo de antes. */
	.sobre__etiqueta {
		padding: var(--etiqueta-espaco);
		border-radius: var(--radius-pilula);
		background: var(--etiqueta-fundo);
		color: var(--etiqueta-texto);
		font-size: var(--text-pequeno);
		font-weight: var(--peso-medio);
		line-height: var(--leading-pequeno);
	}

	@media (min-width: 768px) {
		.sobre {
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			grid-template-rows: auto auto;
			gap: var(--space-grande) var(--grade-espaco);
		}

		.sobre__link--curriculo {
			grid-area: 2 / 1;
			margin-block-start: 0;
		}

		.sobre__coluna--experiencia {
			grid-area: 1 / 2 / span 2;
		}

		.sobre__coluna--formacao {
			grid-area: 1 / 3;
		}

		.sobre__link--linkedin {
			grid-area: 2 / 3;
		}

		/* Os dois links na mesma linha de base. */
		.sobre__link {
			align-self: start;
		}
	}
</style>
