---
/**
 * Sobre: três colunas de mesma largura a partir de 768 px (Descrição, Experiência profissional,
 * Formação acadêmica). A foto abre a coluna da descrição; na rodada 2 ela desce da abertura até aqui.
 * Abaixo das colunas, "Mais informações no LinkedIn".
 * Texto em RASCUNHO, a partir de docs/curriculo.md, para a Taiane reescrever com as palavras dela.
 */
import { Image } from "astro:assets";
import retrato from "../../assets/taiane-retrato.png";
import { perfil } from "../../dados/perfil";
import { experienciasDoSobre, formacaoDoSobre } from "../../dados/trajetoria";
import LinkComSeta from "../ui/LinkComSeta.astro";

/** "2025–2026" vira duas datas, e o leitor de tela lê "2025 até 2026". */
const partes = (periodo: string) => periodo.split("–");
---

<section class="secao envoltorio" id="sobre" aria-labelledby="sobre-titulo">
	<h2 id="sobre-titulo" class="secao__rotulo">
		Sobre
	</h2>

	<div class="sobre">
		<div class="sobre__coluna">
			<Image
				class="sobre__retrato"
				src={retrato}
				alt=""
				widths={[320, 640]}
				sizes="(min-width: 768px) 16rem, 70vw"
			/>
			<div class="rascunho">
				<p class="marcador">[RASCUNHO]</p>
				<p>
					Sou designer de produto há mais de 10 anos, na ponte entre estratégia de negócio,
					experiência do usuário e engenharia. Hoje atuo como Design Engineer: uso front-end e IA
					generativa para encurtar o caminho entre hipótese, protótipo e código funcional.
				</p>
			</div>
			{perfil.curriculo.disponivel ? (
				<LinkComSeta href={perfil.curriculo.href} texto="Acessar currículo em PDF" externo />
			) : (
				<p class="sobre__secundario">Currículo em PDF, em breve</p>
			)}
		</div>

		<div class="sobre__coluna">
			<h3 class="sobre__grupo-titulo">Experiência profissional</h3>
			<ol class="sobre__lista" role="list">
				{experienciasDoSobre.map((item) => (
					<li>
						<p class="sobre__forte">{item.empresa}</p>
						<p>{item.cargo}</p>
						<p class="sobre__secundario">
							{partes(item.periodo).map((ano, i) => (
								<>
									{i > 0 && (
										<>
											<span aria-hidden="true">–</span>
											<span class="so-leitor-de-tela">até</span>
										</>
									)}
									<time datetime={ano}>{ano}</time>
								</>
							))}
						</p>
					</li>
				))}
			</ol>
		</div>

		<div class="sobre__coluna">
			<h3 class="sobre__grupo-titulo">Formação acadêmica</h3>
			<ol class="sobre__lista" role="list">
				{formacaoDoSobre.map((item) => (
					<li class:list={[{ "sobre__item-secundario": !item.concluida }]}>
						<p class="sobre__forte">{item.instituicao}</p>
						<p>{item.curso}</p>
						<p class="sobre__secundario">
							{item.periodo}
							{!item.concluida && " (não concluída)"}
						</p>
					</li>
				))}
			</ol>
		</div>
	</div>

	<div>
		<LinkComSeta href={perfil.linkedin} texto="Mais informações no LinkedIn" externo />
	</div>
</section>

<style>
	.sobre {
		display: grid;
		gap: var(--space-bloco);
	}

	.sobre__coluna {
		display: grid;
		align-content: start;
		justify-items: start;
		gap: var(--space-grande);
	}

	.sobre__retrato {
		inline-size: min(100%, 16rem);
		aspect-ratio: var(--retrato-proporcao);
		object-fit: cover;
		object-position: 50% 30%;
		border-radius: var(--retrato-raio);
	}

	.sobre__grupo-titulo {
		font-weight: var(--peso-corpo);
		line-height: var(--leading-corpo);
		color: var(--color-texto-secundario);
	}

	.sobre__lista {
		display: grid;
		gap: var(--space-medio);
		padding: 0;
		list-style: none;
	}

	.sobre__forte {
		font-weight: var(--peso-forte);
	}

	.sobre__secundario {
		color: var(--color-texto-secundario);
	}

	/* Curso não concluído: tudo em cinza e em texto pequeno, com menos destaque. */
	.sobre__item-secundario {
		color: var(--color-texto-secundario);
		font-size: var(--text-pequeno);
		line-height: var(--leading-pequeno);
	}

	.sobre__item-secundario .sobre__forte {
		font-weight: var(--peso-titulo);
	}

	@media (min-width: 768px) {
		.sobre {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: var(--grade-espaco);
		}
	}
</style>
