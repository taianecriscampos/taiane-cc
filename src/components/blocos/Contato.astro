---
/**
 * Contato. Sem formulário na versão 1 (ADR 0001): e-mail e LinkedIn.
 */
import { perfil } from "../../dados/perfil";
---

<section class="secao envoltorio" id="contato" aria-labelledby="contato-titulo">
	<h2 id="contato-titulo">Contato</h2>
	<p class="marcador">[RASCUNHO]</p>
	<p>Quer conversar sobre um projeto ou uma vaga? Me escreva por e-mail ou pelo LinkedIn.</p>
	<ul class="contato" role="list">
		<li>
			<a href={`mailto:${perfil.email}`}>{perfil.email}</a>
		</li>
		<li>
			<a href={perfil.linkedin}>LinkedIn</a>
		</li>
	</ul>
</section>

<style>
	.contato {
		display: grid;
		gap: var(--space-pequeno);
		padding: 0;
		list-style: none;
		font-size: var(--text-titulo-3);
	}

	.contato a {
		overflow-wrap: anywhere;
	}
</style>
