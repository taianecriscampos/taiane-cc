---
/**
 * "Vamos conversar?": título, texto curto e LinkedIn, em 6, 3 e 3 colunas a partir de 1200 px.
 * Sem formulário na versão 1 (ADR 0001).
 */
import { perfil } from "../../dados/perfil";
import LinkComSeta from "../ui/LinkComSeta.astro";
---

<section class="secao envoltorio" id="contato" aria-labelledby="contato-titulo">
	<div class="contato">
		<h2 id="contato-titulo" class="contato__titulo">
			Vamos conversar?
		</h2>
		<div class="rascunho contato__texto">
			<p class="marcador">[RASCUNHO]</p>
			<p>Sobre vagas, projetos e trocas sobre design, IA e código.</p>
		</div>
		<div class="contato__link">
			<LinkComSeta href={perfil.linkedin} texto="Me encontre no LinkedIn" />
		</div>
	</div>
</section>

<style>
	.contato {
		display: grid;
		gap: var(--space-medio);
	}

	.contato__titulo {
		font-size: var(--text-entrada);
	}

	@media (min-width: 768px) {
		.contato {
			grid-template-columns: repeat(var(--grade-colunas), minmax(0, 1fr));
			column-gap: var(--grade-espaco);
		}

		.contato__titulo {
			grid-column: 1 / -1;
		}

		.contato__texto {
			grid-column: 1 / span 8;
		}

		.contato__link {
			grid-column: 9 / -1;
			justify-self: end;
		}
	}

	@media (min-width: 1200px) {
		.contato {
			align-items: start;
		}

		.contato__titulo {
			grid-column: 1 / span 6;
		}

		.contato__texto {
			grid-column: 7 / span 3;
		}

		.contato__link {
			grid-column: 10 / -1;
		}
	}
</style>
