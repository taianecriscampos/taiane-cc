---
/**
 * Ferramentas em texto. Os logos monocromáticos entram na 0.4.0 (briefing de design).
 */
import { ferramentas } from "../../dados/trajetoria";
---

<section class="secao envoltorio" id="ferramentas" aria-labelledby="ferramentas-titulo">
	<h2 id="ferramentas-titulo">Ferramentas</h2>
	<ul class="ferramentas" role="list">
		{ferramentas.map((ferramenta) => (
			<li>{ferramenta}</li>
		))}
	</ul>
</section>

<style>
	.ferramentas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-pequeno) var(--space-grande);
		padding: 0;
		list-style: none;
		font-size: var(--text-subtitulo);
	}
</style>
