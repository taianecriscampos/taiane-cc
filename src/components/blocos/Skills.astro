---
/**
 * Skills: duas colunas a partir de 768 px, "Hard skills" e "Soft skills", com títulos no mesmo
 * estilo do Sobre. Em Hard skills, as competências e as ferramentas, cada ferramenta com o ícone
 * monocromático (Simple Icons, em cinza) e o nome. Visual discreto: listas simples.
 * A nuvem magnética fica para a Rodada 2.
 */
import { competencias, ferramentas, softSkills } from "../../dados/skills";
---

<section class="secao envoltorio" id="skills" aria-labelledby="skills-titulo">
	<h2 id="skills-titulo" class="secao__rotulo">
		Skills
	</h2>

	<div class="skills">
		<div class="skills__coluna">
			<h3 class="skills__titulo">Hard skills</h3>

			<div class="skills__grupo">
				<h4 class="skills__subtitulo">Competências</h4>
				<ul class="skills__lista" role="list">
					{competencias.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</div>

			<div class="skills__grupo">
				<h4 class="skills__subtitulo">Ferramentas e tecnologias</h4>
				<ul class="skills__ferramentas" role="list">
					{ferramentas.map((f) => (
						<li class="skills__ferramenta">
							{f.icone && (
								<svg class="skills__icone" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path d={f.icone} />
								</svg>
							)}
							{f.nome}
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class="skills__coluna">
			<h3 class="skills__titulo">Soft skills</h3>
			<ul class="skills__lista" role="list">
				{softSkills.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	.skills {
		display: grid;
		gap: var(--space-bloco);
	}

	.skills__coluna {
		display: grid;
		align-content: start;
		gap: var(--space-grande);
	}

	.skills__titulo,
	.skills__subtitulo {
		font-weight: var(--peso-corpo);
		line-height: var(--leading-corpo);
		color: var(--color-texto-secundario);
	}

	.skills__titulo {
		font-size: var(--text-corpo);
	}

	.skills__subtitulo {
		font-size: var(--text-pequeno);
		line-height: var(--leading-pequeno);
	}

	.skills__grupo {
		display: grid;
		gap: var(--space-pequeno);
	}

	.skills__lista,
	.skills__ferramentas {
		display: grid;
		gap: var(--space-minimo);
		padding: 0;
		list-style: none;
	}

	.skills__ferramentas {
		grid-template-columns: repeat(auto-fill, minmax(var(--skill-coluna-minima), 1fr));
		gap: var(--space-pequeno) var(--space-medio);
	}

	.skills__ferramenta {
		display: flex;
		align-items: center;
		gap: var(--space-pequeno);
	}

	/* Sem ícone: o nome começa na mesma linha vertical dos outros. */
	.skills__ferramenta:not(:has(.skills__icone)) {
		padding-inline-start: calc(var(--skill-icone) + var(--space-pequeno));
	}

	.skills__icone {
		flex: none;
		inline-size: var(--skill-icone);
		block-size: var(--skill-icone);
		fill: var(--skill-icone-cor);
	}

	@media (min-width: 768px) {
		.skills {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--grade-espaco);
		}
	}
</style>
