---
/**
 * Fechamento padrão de todo case: convite para o LinkedIn e nota de confidencialidade.
 * A nota está em RASCUNHO, para a Taiane trocar pelas palavras dela.
 */
import { perfil } from "../../dados/perfil";
import LinkComSeta from "../ui/LinkComSeta.astro";

interface Props {
	sigilo: "publico" | "confidencial";
}

const { sigilo } = Astro.props;

const nota =
	sigilo === "confidencial"
		? "Este projeto está sob acordo de confidencialidade. Telas, números internos e documentos ficaram de fora; o texto mostra o processo e o meu papel."
		: "Informações internas e dados de clientes foram omitidos ou generalizados.";
---

<section class="fechamento" aria-labelledby="fechamento-titulo">
	<h2 id="fechamento-titulo" class="fechamento__titulo">
		Quer saber mais detalhes?
	</h2>
	<LinkComSeta href={perfil.linkedin} texto="Fale comigo no LinkedIn" />
	<div class="rascunho">
		<p class="marcador">[RASCUNHO]</p>
		<p class="fechamento__nota">{nota}</p>
	</div>
</section>

<style>
	.fechamento {
		display: grid;
		justify-items: start;
		gap: var(--space-grande);
	}

	.fechamento__titulo {
		font-size: var(--text-secao-case);
		font-weight: var(--peso-corpo);
		line-height: var(--leading-secao-case);
	}

	.fechamento__nota {
		font-size: var(--text-pequeno);
		line-height: var(--leading-pequeno);
		color: var(--color-texto-secundario);
	}
</style>
