---
/**
 * Seta para baixo (leva aos projetos) e "Me encontre no LinkedIn" (briefing v2).
 */
import { perfil } from "../../dados/perfil";

interface Props {
	class?: string;
}

const { class: classe } = Astro.props;
---

<div class:list={["acoes", classe]}>
	<a class="acoes__seta" href="#projetos" aria-label="Ir para os projetos">
		<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
			<path
				d="M12 5v14M6 13l6 6 6-6"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
		</svg>
	</a>
	<a class="acoes__linkedin" href={perfil.linkedin}>
		Me encontre no LinkedIn
	</a>
</div>

<style>
	.acoes {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-medio);
	}

	.acoes__seta {
		display: grid;
		place-items: center;
		inline-size: var(--alvo-toque);
		block-size: var(--alvo-toque);
		border-radius: var(--radius-pilula);
		background: var(--seta-fundo);
	}

	.acoes__seta svg {
		inline-size: var(--space-grande);
		block-size: var(--space-grande);
		padding: var(--space-minimo);
	}
</style>
