---
/**
 * Versão 1, "Slide limpo". Eixo: escala e respiro.
 * A frase domina a primeira tela, como um slide; foto pequena e bloco bento ficam na base.
 */
import { Image } from "astro:assets";
import retrato from "../../assets/taiane-retrato.png";
import { perfil } from "../../dados/perfil";
import Acoes from "./Acoes.astro";
import InfoBento from "./InfoBento.astro";
---

<section class="slide envoltorio" aria-labelledby="abertura-titulo">
	<h1 id="abertura-titulo" class="slide__frase">
		{perfil.frase}
	</h1>

	<div class="slide__base">
		<div class="slide__foto">
			<Image
				src={retrato}
				alt={`Retrato de ${perfil.nome}: cabelo escuro na altura dos ombros, com mechas grisalhas, e óculos de armação redonda e fina, sobre fundo claro.`}
				widths={[240, 360]}
				sizes="8rem"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
		<div class="slide__info">
			<InfoBento />
		</div>
		<div class="slide__acoes">
			<Acoes />
		</div>
	</div>
</section>

<style>
	.slide {
		display: grid;
		align-content: space-between;
		gap: var(--space-bloco);
		min-block-size: 88svh;
		padding-block: var(--space-secao) var(--space-grande);
	}

	.slide__frase {
		max-inline-size: 18ch;
	}

	.slide__base {
		display: grid;
		grid-template-columns: var(--largura-foto-pequena) minmax(0, 1fr);
		align-items: stretch;
		gap: var(--bento-intervalo);
	}

	.slide__foto img {
		inline-size: 100%;
		block-size: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: var(--foto-raio);
	}

	.slide__info {
		display: grid;
	}

	.slide__acoes {
		grid-column: 1 / -1;
		padding-block-start: var(--space-medio);
	}

	@media (min-width: 48rem) {
		.slide__base {
			grid-template-columns: var(--largura-foto-pequena) var(--largura-indice) minmax(0, 1fr);
			align-items: end;
		}

		.slide__info {
			align-self: stretch;
		}

		.slide__acoes {
			grid-column: 3;
			justify-self: end;
			padding: 0;
		}
	}
</style>
