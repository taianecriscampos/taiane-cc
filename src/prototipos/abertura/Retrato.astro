---
/**
 * Versão 3, "Retrato". Eixo: imagem protagonista.
 * Frase em Archivo condensada à esquerda; foto alta à direita, com o bloco bento sobre o canto dela.
 */
import { Image } from "astro:assets";
import retrato from "../../assets/taiane-retrato.png";
import { perfil } from "../../dados/perfil";
import Acoes from "./Acoes.astro";
import InfoBento from "./InfoBento.astro";
---

<section class="retrato envoltorio" aria-labelledby="abertura-titulo">
	<div class="retrato__texto">
		<h1 id="abertura-titulo" class="retrato__frase">
			{perfil.frase}
		</h1>
		<Acoes />
	</div>

	<div class="retrato__figura">
		<Image
			src={retrato}
			alt={`Retrato de ${perfil.nome}: cabelo escuro na altura dos ombros, com mechas grisalhas, e óculos de armação redonda e fina, sobre fundo claro.`}
			widths={[360, 512]}
			sizes="(min-width: 48rem) 40vw, 90vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="retrato__info">
			<InfoBento />
		</div>
	</div>
</section>

<style>
	.retrato {
		display: grid;
		gap: var(--space-bloco);
		padding-block: var(--space-bloco) var(--space-grande);
	}

	.retrato__texto {
		display: grid;
		align-content: space-between;
		gap: var(--space-bloco);
	}

	.retrato__frase {
		font-stretch: var(--largura-fonte-condensada);
		max-inline-size: 14ch;
	}

	.retrato__figura {
		position: relative;
	}

	.retrato__figura img {
		inline-size: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--foto-raio);
	}

	.retrato__info {
		position: absolute;
		inset-inline-start: var(--space-pequeno);
		inset-block-end: var(--space-pequeno);
		display: grid;
		min-inline-size: var(--largura-coluna-minima);
	}

	@media (min-width: 48rem) {
		.retrato {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: stretch;
			min-block-size: 80svh;
		}

		.retrato__texto {
			padding-block: var(--space-grande);
		}

		.retrato__info {
			inset-inline-start: calc(-1 * var(--space-bloco));
			inset-block-end: var(--space-grande);
		}
	}
</style>
