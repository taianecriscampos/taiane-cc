---
/**
 * Menu versão 2, "Ilha". Eixo: discreto e translúcido, muda de lugar com a tela.
 * No celular e no tablet, pílula clara na base. No computador, sobe para o topo,
 * com o nome como marca à esquerda e ícone ao lado do rótulo.
 */
import { perfil } from "../../dados/perfil";
import Icone from "./Icone.astro";
import { itensDoMenu } from "./itens";
---

<nav class="ilha" aria-label="Menu principal" data-menu>
	<a class="ilha__marca" href="#inicio">
		{perfil.nome}
	</a>
	<ul class="ilha__lista" role="list">
		{itensDoMenu.map((item) => (
			<li>
				<a class="ilha__item" href={item.href}>
					<Icone nome={item.nome} />
					<span>{item.rotulo}</span>
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	.ilha {
		position: fixed;
		z-index: var(--menu-camada);
		inset-inline: 0;
		inset-block-end: calc(var(--menu-afastamento) + env(safe-area-inset-bottom, 0));
		inline-size: min(calc(100% - 2 * var(--space-margem-pagina)), var(--menu-largura));
		margin-inline: auto;
		padding: var(--space-minimo);
		border-radius: var(--menu-raio);
		background: var(--menu-claro-fundo);
		-webkit-backdrop-filter: var(--menu-desfoque);
		backdrop-filter: var(--menu-desfoque);
		box-shadow: var(--menu-sombra);
	}

	/* No celular, a marca fica no rodapé: a pílula leva só os quatro itens. */
	.ilha__marca {
		display: none;
	}

	.ilha__lista {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-minimo);
		padding: 0;
		list-style: none;
	}

	.ilha__item {
		display: grid;
		justify-items: center;
		gap: var(--space-minimo);
		min-block-size: var(--menu-item-altura);
		padding-block: var(--space-pequeno);
		border-radius: var(--menu-raio);
		color: var(--menu-claro-texto);
		font-size: var(--text-pequeno);
		font-weight: var(--peso-rotulo);
		line-height: var(--leading-titulo);
		text-decoration: none;
		transition: color var(--motion-duration-fast) var(--motion-ease-out);
		-webkit-tap-highlight-color: transparent;
	}

	.ilha__item[aria-current] {
		background: var(--menu-claro-realce);
		color: var(--menu-claro-ativo);
	}

	@media (hover: hover) {
		.ilha__item:hover {
			color: var(--menu-claro-ativo);
		}
	}

	@media (min-width: 64rem) {
		.ilha {
			display: flex;
			align-items: center;
			gap: var(--space-medio);
			inset-block: var(--menu-afastamento) auto;
			inset-inline: auto var(--space-margem-pagina);
			inline-size: auto;
			padding-inline-start: var(--space-medio);
		}

		.ilha__marca {
			display: block;
			font-weight: var(--peso-titulo);
			font-stretch: var(--largura-fonte-titulo);
			text-decoration: none;
			white-space: nowrap;
		}

		.ilha__lista {
			display: flex;
		}

		.ilha__item {
			display: flex;
			align-items: center;
			gap: var(--space-pequeno);
			padding-inline: var(--space-medio);
			padding-block: 0;
		}
	}
</style>
