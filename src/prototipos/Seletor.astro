---
/**
 * Seletor de versões da skill prototype (PICKER.md). A aparência é a da especificação,
 * copiada sem mudança: é ferramenta do Laboratório, não parte do design. Por isso não usa tokens.
 *
 * Cada versão fica num <template data-variante> da página; o seletor monta uma por vez em #palco.
 * A versão pode dizer onde o seletor fica, para ele não cobrir o trabalho (única mudança permitida):
 * data-seletor="top" sempre no topo; data-seletor="top-no-celular" no topo só abaixo de 64rem.
 * Teclas: 1 a N e setas trocam a versão. A escolha fica no endereço (?v=2).
 */
interface Props {
	nomes: string[];
}

const { nomes } = Astro.props;
---

<nav class="proto-picker" aria-label="Versões do protótipo">
	<span class="proto-picker-highlight" aria-hidden="true"></span>
	{nomes.map((nome, i) => (
		<button type="button" class="proto-picker-item" data-active={i === 0 ? "" : undefined}>
			{nome}
		</button>
	))}
</nav>

<script>
	import { iniciarHoraLocal } from "../scripts/hora-local";

	const palco = document.getElementById("palco");
	const seletor = document.querySelector<HTMLElement>(".proto-picker");
	const modelos = [...document.querySelectorAll<HTMLTemplateElement>("template[data-variante]")];

	if (palco && seletor && modelos.length > 0) {
		const realce = seletor.querySelector<HTMLElement>(".proto-picker-highlight");
		const itens = [...seletor.querySelectorAll<HTMLButtonElement>(".proto-picker-item")];
		let atual = 0;

		const moverRealce = () => {
			const item = itens[atual];
			if (!item || !realce) return;
			realce.style.width = `${item.offsetWidth}px`;
			realce.style.transform = `translateX(${item.offsetLeft}px)`;
		};

		const posicionar = () => {
			const pedido = modelos[atual]?.dataset.seletor;
			const noTopo =
				pedido === "top" ||
				(pedido === "top-no-celular" && !matchMedia("(min-width: 64rem)").matches);
			if (noTopo) seletor.dataset.position = "top";
			else delete seletor.dataset.position;
		};

		// Limpa e monta no quadro seguinte, para as animações de entrada recomeçarem.
		const montar = (i: number) => {
			palco.replaceChildren();
			requestAnimationFrame(() => {
				const modelo = modelos[i];
				if (!modelo) return;
				palco.append(modelo.content.cloneNode(true));
				iniciarHoraLocal();
				document.dispatchEvent(new CustomEvent("prototipo:montado"));
			});
		};

		const ativar = (i: number) => {
			if (i < 0 || i >= modelos.length) return;
			atual = i;
			itens.forEach((item, j) => {
				item.toggleAttribute("data-active", j === i);
				if (j === i) item.setAttribute("aria-current", "true");
				else item.removeAttribute("aria-current");
			});
			moverRealce();
			posicionar();
			const url = new URL(location.href);
			url.searchParams.set("v", String(i + 1));
			history.replaceState(null, "", url);
			montar(i);
		};

		itens.forEach((item, i) => item.addEventListener("click", () => ativar(i)));
		window.addEventListener("resize", () => {
			moverRealce();
			posicionar();
		});

		document.addEventListener("keydown", (e) => {
			const alvo = e.target as HTMLElement;
			if (/^(INPUT|TEXTAREA|SELECT)$/.test(alvo.tagName) || alvo.isContentEditable) return;
			if (e.metaKey || e.ctrlKey || e.altKey) return;
			const numero = Number.parseInt(e.key, 10);
			if (numero >= 1 && numero <= modelos.length) ativar(numero - 1);
			else if (e.key === "ArrowRight") ativar((atual + 1) % modelos.length);
			else if (e.key === "ArrowLeft") ativar((atual - 1 + modelos.length) % modelos.length);
		});

		ativar((Number.parseInt(new URLSearchParams(location.search).get("v") ?? "", 10) || 1) - 1);
		// O deslize do realce só liga depois da primeira pintura, para não animar no carregamento.
		requestAnimationFrame(() =>
			requestAnimationFrame(() => seletor.setAttribute("data-ready", "")),
		);
	}
</script>

<style>
	.proto-picker {
		position: fixed;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2147483647;
		display: flex;
		align-items: center;
		gap: 2px;
		padding: 4px;
		border-radius: 999px;
		background: rgba(10, 10, 10, 0.82);
		-webkit-backdrop-filter: blur(12px) saturate(1.4);
		backdrop-filter: blur(12px) saturate(1.4);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.08) inset,
			0 8px 24px rgba(0, 0, 0, 0.24),
			0 2px 6px rgba(0, 0, 0, 0.12);
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		font-size: 13px;
		line-height: 1;
		-webkit-font-smoothing: antialiased;
		user-select: none;
		-webkit-user-select: none;
	}

	.proto-picker-highlight {
		position: absolute;
		top: 4px;
		left: 0;
		height: 28px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.12);
		will-change: transform;
	}

	.proto-picker[data-ready] .proto-picker-highlight {
		transition:
			transform 250ms cubic-bezier(0.23, 1, 0.32, 1),
			width 250ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		.proto-picker[data-ready] .proto-picker-highlight {
			transition: none;
		}
	}

	.proto-picker-item {
		position: relative;
		display: flex;
		align-items: center;
		height: 28px;
		padding: 0 12px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: rgba(255, 255, 255, 0.55);
		font: inherit;
		cursor: pointer;
		transition: color 150ms ease-out;
	}

	.proto-picker-item:hover {
		color: rgba(255, 255, 255, 0.85);
	}

	.proto-picker-item:active {
		transform: scale(0.97);
	}

	.proto-picker-item:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.4);
		outline-offset: 2px;
	}

	.proto-picker-item[data-active] {
		color: #fff;
	}

	.proto-picker[data-position="top"] {
		bottom: auto;
		top: 24px;
	}
</style>
